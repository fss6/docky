<% content_for :title, "Envios de lembretes · Plataforma" %>

<div class="space-y-6">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-accent">
        <%= link_to "Sistema", platform_settings_path, class: "text-accent hover:underline" %>
        <span class="text-zinc-400">/</span>
        <%= link_to "Plataforma", platform_settings_path, class: "text-accent hover:underline" %>
        <span class="text-zinc-400">/</span>
        <span class="text-zinc-600">Envios</span>
      </p>
      <h1 class="mt-1 text-2xl font-semibold tracking-tight text-zinc-900 sm:text-3xl">Monitor de envios de lembretes</h1>
      <p class="mt-2 max-w-2xl text-sm text-zinc-600">
        Cada linha é um <strong>dispatch</strong> (ciclo de envio por cliente, competência e etapa). Status <code class="text-xs">scheduled</code> antigo pode indicar worker Sidekiq parado ou fora da janela de envio do escritório.
      </p>
    </div>
    <div class="flex shrink-0 flex-wrap gap-2">
      <%= link_to "Configurações da plataforma", platform_settings_path, class: "app-btn-secondary no-underline text-sm" %>
    </div>
  </header>

  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
    <div class="app-card p-4">
      <p class="text-xs font-medium text-zinc-500">Agendados (7 dias)</p>
      <p class="mt-1 text-2xl font-semibold tabular-nums text-zinc-900"><%= @kpis[:scheduled] %></p>
    </div>
    <div class="app-card p-4">
      <p class="text-xs font-medium text-zinc-500">Enviados (7 dias)</p>
      <p class="mt-1 text-2xl font-semibold tabular-nums text-emerald-700"><%= @kpis[:sent] %></p>
    </div>
    <div class="app-card p-4">
      <p class="text-xs font-medium text-zinc-500">Falhas (7 dias)</p>
      <p class="mt-1 text-2xl font-semibold tabular-nums text-red-700"><%= @kpis[:failed] %></p>
    </div>
    <div class="app-card p-4">
      <p class="text-xs font-medium text-zinc-500">Ignorados (7 dias)</p>
      <p class="mt-1 text-2xl font-semibold tabular-nums text-zinc-700"><%= @kpis[:skipped] %></p>
    </div>
    <div class="app-card p-4 <%= @stale_scheduled_count.positive? ? "border-amber-200 bg-amber-50" : "" %>">
      <p class="text-xs font-medium text-zinc-500">Scheduled órfãos (&gt;1h)</p>
      <p class="mt-1 text-2xl font-semibold tabular-nums text-amber-900"><%= @stale_scheduled_count %></p>
    </div>
  </div>

  <div class="flex flex-wrap gap-2">
    <%= platform_dispatch_status_filter_chip("Todos", nil) %>
    <%= platform_dispatch_status_filter_chip("Agendados", "scheduled") %>
    <%= platform_dispatch_status_filter_chip("Enviados", "sent") %>
    <%= platform_dispatch_status_filter_chip("Falhas", "failed") %>
    <%= platform_dispatch_status_filter_chip("Ignorados", "skipped") %>
  </div>

  <details class="app-card group" <%= "open" if params.slice(:channel, :account_id, :skip_reason, :from, :to, :q).values.any?(&:present?) %>>
    <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 text-left [&::-webkit-details-marker]:hidden">
      <span class="text-sm font-semibold text-zinc-900">Filtros</span>
      <svg class="h-4 w-4 shrink-0 text-zinc-400 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
      </svg>
    </summary>
    <div class="border-t border-zinc-100 px-4 py-4">
      <%= form_with url: collection_dispatches_platform_settings_path, method: :get do %>
        <%= hidden_field_tag :status, @filters.status if @filters.status.present? %>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          <div>
            <%= label_tag :channel, "Canal", class: "app-label" %>
            <%= select_tag :channel,
                  options_for_select([["Todos", ""]] + CollectionDispatch.channels.keys.map { |c| [platform_dispatch_channel_label(c), c] }, @filters.channel),
                  class: "app-input" %>
          </div>
          <div>
            <%= label_tag :account_id, "Escritório", class: "app-label" %>
            <%= select_tag :account_id, options_for_select([["Todos", ""]] + @account_options, @filters.account_id), class: "app-input" %>
          </div>
          <div>
            <%= label_tag :skip_reason, "Motivo (código)", class: "app-label" %>
            <%= text_field_tag :skip_reason, @filters.skip_reason, class: "app-input", placeholder: "email_not_configured" %>
          </div>
          <div>
            <%= label_tag :from, "Criado desde", class: "app-label" %>
            <%= date_field_tag :from, @filters.from, class: "app-input" %>
          </div>
          <div>
            <%= label_tag :to, "Criado até", class: "app-label" %>
            <%= date_field_tag :to, @filters.to, class: "app-input" %>
          </div>
          <div class="sm:col-span-2">
            <%= label_tag :q, "Cliente", class: "app-label" %>
            <%= text_field_tag :q, @filters.q, class: "app-input", placeholder: "Nome ou e-mail do cliente" %>
          </div>
        </div>
        <div class="mt-4 flex flex-wrap gap-2">
          <%= submit_tag "Filtrar", class: "app-btn-primary" %>
          <%= link_to "Limpar", collection_dispatches_platform_settings_path, class: "app-btn-secondary no-underline" %>
        </div>
      <% end %>
    </div>
  </details>

  <div class="app-card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-zinc-100 text-sm">
        <thead class="bg-zinc-50 text-left text-xs font-semibold uppercase tracking-wide text-zinc-500">
          <tr>
            <th class="px-4 py-3">Criado</th>
            <th class="px-4 py-3">Escritório</th>
            <th class="px-4 py-3">Cliente</th>
            <th class="px-4 py-3">Competência</th>
            <th class="px-4 py-3">Etapa</th>
            <th class="px-4 py-3">Canal</th>
            <th class="px-4 py-3">Status</th>
            <th class="px-4 py-3">Motivo</th>
            <th class="px-4 py-3">Enviado</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-100 bg-white">
          <% if @dispatches.empty? %>
            <tr>
              <td colspan="10" class="px-4 py-8 text-center text-zinc-500">Nenhum envio encontrado.</td>
            </tr>
          <% else %>
            <% @dispatches.each do |dispatch| %>
              <tr class="hover:bg-zinc-50/80">
                <td class="whitespace-nowrap px-4 py-3 tabular-nums text-zinc-600">
                  <%= l(dispatch.created_at, format: :short) %>
                </td>
                <td class="px-4 py-3 text-zinc-900"><%= dispatch.account.name %></td>
                <td class="px-4 py-3">
                  <span class="font-medium text-zinc-900"><%= dispatch.client.name %></span>
                  <% if dispatch.client.email.present? %>
                    <span class="block text-xs text-zinc-500"><%= dispatch.client.email %></span>
                  <% end %>
                </td>
                <td class="whitespace-nowrap px-4 py-3 tabular-nums text-zinc-600">
                  <%= dispatch.period.period.strftime("%Y-%m") %>
                </td>
                <td class="px-4 py-3 text-zinc-700"><%= dispatch.collection_step.name %></td>
                <td class="px-4 py-3"><%= platform_dispatch_channel_label(dispatch.channel) %></td>
                <td class="px-4 py-3">
                  <span class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold <%= platform_dispatch_status_chip_class(dispatch) %>">
                    <%= platform_dispatch_status_label(dispatch.status) %>
                  </span>
                </td>
                <td class="max-w-[12rem] truncate px-4 py-3 text-xs text-zinc-600" title="<%= dispatch.skip_reason %>">
                  <%= platform_dispatch_skip_reason_label(dispatch.skip_reason) %>
                </td>
                <td class="whitespace-nowrap px-4 py-3 tabular-nums text-zinc-600">
                  <%= dispatch.sent_at ? l(dispatch.sent_at, format: :short) : "—" %>
                </td>
                <td class="whitespace-nowrap px-4 py-3 text-right">
                  <%= link_to "Detalhe", platform_collection_dispatch_platform_settings_path(dispatch), class: "text-sm font-semibold text-accent hover:underline" %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @pagy.pages > 1 %>
      <div class="flex justify-center border-t border-zinc-100 px-4 py-4">
        <%== @pagy.series_nav %>
      </div>
    <% end %>
  </div>
</div>
