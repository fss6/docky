<p style="margin:0 0 8px;font-size:13px;line-height:1.45;color:#71717a;">
  <%= @account_name %>
</p>

<div style="font-size:15px;line-height:1.6;color:#3f3f46;">
  <%= simple_format(@body, {}, sanitize: false) %>
</div>

<p style="margin:28px 0 0;font-size:14px;line-height:1.5;color:#52525b;">
  Se o link acima não abrir, copie e cole no navegador:
</p>
<p style="margin:8px 0 0;word-break:break-all;">
  <a href="<%= @upload_url %>" style="color:#1a6fff;font-weight:600;text-decoration:none;"><%= @upload_url %></a>
</p>
