<% content_for :title, "Clientes · Dokivo" %>

<div class="space-y-8">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-accent">Contabilidade</p>
      <h1 class="mt-1 text-2xl font-semibold tracking-tight text-zinc-900 sm:text-3xl">Clientes</h1>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-zinc-600">
        Cadastro de empresas e pessoas atendidas pelo escritório. Busque por nome, CNPJ/CPF ou e-mail e filtre por status operacional.
      </p>
    </div>
    <%= link_to "Novo cliente", new_client_path, class: "app-btn-primary w-full shrink-0 text-center no-underline sm:w-auto" %>
  </header>

  <%= form_with url: clients_path, method: :get, class: "app-card px-4 py-4 sm:px-5" do %>
    <div class="flex flex-col gap-3 md:flex-row md:items-end">
      <div class="min-w-0 flex-1">
        <%= label_tag :q, "Busca", class: "app-label" %>
        <div class="relative">
          <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-zinc-400" aria-hidden="true">
            <%= heroicon "magnifying-glass", variant: :outline, options: { class: "h-4 w-4" } %>
          </span>
          <%= text_field_tag :q, @search_query, class: "app-input pl-10", placeholder: "Buscar por nome, CNPJ/CPF ou e-mail…" %>
        </div>
      </div>
      <div class="w-full md:w-48 md:shrink-0">
        <%= label_tag :status, "Status operacional", class: "app-label" %>
        <%= select_tag :status,
              options_for_select(
                [
                  ["Todos", ""],
                  ["Ativo", "active"],
                  ["Em onboarding", "onboarding"]
                ],
                @selected_status
              ),
              class: "app-input" %>
      </div>
      <div class="flex shrink-0 items-center justify-end gap-2">
        <%= link_to "Limpar", clients_path, class: "app-btn-secondary no-underline" %>
        <%= submit_tag "Aplicar", class: "app-btn-primary cursor-pointer border-0" %>
      </div>
    </div>
  <% end %>

  <% if @clients.any? %>
    <%= render "clients/clients_table", clients: @clients, pagy: @pagy %>
  <% elsif !@account_has_clients %>
    <div class="app-card p-8 text-center text-sm text-zinc-600">
      <p>Nenhum cliente cadastrado ainda.</p>
      <p class="mt-2"><%= link_to "Criar o primeiro cliente", new_client_path, class: "font-medium text-accent no-underline hover:underline" %></p>
    </div>
  <% else %>
    <div class="app-card p-8 text-center text-sm text-zinc-600">
      <p>Nenhum cliente encontrado para os filtros.</p>
      <p class="mt-2"><%= link_to "Limpar filtros", clients_path, class: "font-medium text-accent no-underline hover:underline" %></p>
    </div>
  <% end %>
</div>
