<dialog data-share-link-modal-target="dialog"
        data-action="click->share-link-modal#backdropClick"
        class="z-[200] m-0 w-[min(100%,32rem)] max-w-lg border-0 bg-transparent p-0 shadow-none outline-none [&:not([open])]:hidden [&::backdrop]:bg-black/50"
        style="position: fixed; left: 50%; top: 50%; transform: translate(-50%, -50%);"
        aria-labelledby="onboarding-share-modal-title">
  <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-xl">
    <h2 id="onboarding-share-modal-title" class="text-xl font-semibold text-zinc-900">Link para envio de documentos</h2>
    <p class="mt-1 text-sm text-zinc-500">
      <%= client.name %> · válido por 90 dias
    </p>

    <% if active_onboarding_invite&.active? %>
      <%= render "clients/show/onboarding_share_modal_content",
            client: client,
            invite: active_onboarding_invite %>
    <% else %>
      <div id="share_link_modal_content"
           class="mt-5"
           data-share-link-modal-target="content">
        <p class="text-sm text-zinc-500">Gerando link…</p>
      </div>
    <% end %>
  </div>
</dialog>
