<section class="app-card p-4 sm:p-6">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="text-base font-semibold text-zinc-900">Checklist do mês</h2>
      <p class="mt-1 text-sm text-zinc-600"><%= summary[:progress_label] %> · competência <%= l(period, format: "%m/%Y") %></p>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to "Editar checklist", client_checklist_items_path(client, period: period_param), class: "app-btn-secondary no-underline" %>
      <% show_next_month = summary[:pending_count].zero? || summary[:deadline][:days_left].to_i.negative? %>
      <% if show_next_month %>
        <%= link_to "Iniciar próximo mês",
              client_path(client, aba: "documentos", period: (period + 1.month).strftime("%Y-%m")),
              class: "app-btn-primary no-underline" %>
      <% end %>
    </div>
  </div>

  <ul class="mt-6 divide-y divide-zinc-100">
    <% checklist_items.each do |item| %>
      <li class="flex items-center justify-between gap-4 py-3">
        <div class="min-w-0">
          <p class="text-sm font-medium text-zinc-900"><%= item.name_snapshot %></p>
          <p class="text-xs text-zinc-500">
            <% if item.last_document.present? %>
              Recebido · <%= document_file_label(item.last_document) %>
            <% else %>
              Pendente
            <% end %>
          </p>
        </div>
        <span class="shrink-0 rounded-full px-2 py-0.5 text-xs font-semibold <%= item.last_document_id.present? ? 'bg-emerald-50 text-emerald-800' : 'bg-amber-50 text-amber-900' %>">
          <%= item.last_document_id.present? ? "Recebido" : "Pendente" %>
        </span>
      </li>
    <% end %>
    <% if checklist_items.empty? %>
      <li class="py-6 text-center text-sm text-zinc-500">Nenhum item neste mês. Edite o template e aplique ao mês.</li>
    <% end %>
  </ul>
</section>
