<% row_classes = item.complete? ? "bg-emerald-50/70" : "bg-amber-50/60" %>
<li class="flex items-start gap-3 rounded-md px-3 py-2.5 <%= row_classes %>">
  <% if item.complete? %>
    <%= button_to mark_pending_client_onboarding_checklist_item_path(client, item),
          method: :patch,
          class: "mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded border border-emerald-600 bg-emerald-600 text-xs text-white",
          title: "Reabrir item",
          form: { data: { turbo: true } } do %>
      ✓
    <% end %>
  <% else %>
    <%= button_to mark_received_client_onboarding_checklist_item_path(client, item),
          method: :patch,
          class: "mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded border border-zinc-400 bg-white text-transparent hover:border-emerald-600 hover:text-emerald-600",
          title: "Marcar como recebido",
          form: { data: { turbo: true } } do %>
      ✓
    <% end %>
  <% end %>

  <div class="min-w-0 flex-1">
    <p class="text-sm <%= item.complete? ? "text-zinc-600 line-through" : "font-medium text-zinc-900" %>"><%= item.name %></p>
    <p class="text-xs text-zinc-500">
      <% if item.last_document.present? %>
        Recebido <%= l(item.received_at || item.last_document.created_at, format: :short) %> · <%= document_file_label(item.last_document) %>
      <% elsif item.validated? && item.validated_at.present? %>
        Marcado manualmente · <%= l(item.validated_at, format: :short) %>
      <% else %>
        Pendente
      <% end %>
    </p>
  </div>

  <span class="shrink-0 rounded-full px-2 py-0.5 text-xs font-semibold <%= item.complete? ? "bg-emerald-50 text-emerald-800" : "bg-amber-50 text-amber-900" %>">
    <%= item.complete? ? "Recebido" : "Pendente" %>
  </span>
</li>
