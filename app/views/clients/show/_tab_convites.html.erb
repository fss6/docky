<section id="client_upload_invites_panel" class="space-y-4">
  <div class="app-card overflow-hidden">
    <table class="min-w-full text-left text-sm">
      <thead>
        <tr class="border-b border-zinc-100 bg-zinc-50/80 text-xs font-semibold uppercase tracking-wide text-zinc-500">
          <th class="px-4 py-3">Token</th>
          <th class="px-4 py-3">Criado</th>
          <th class="px-4 py-3">Expira</th>
          <th class="px-4 py-3">Acessos</th>
          <th class="px-4 py-3">Status</th>
          <th class="px-4 py-3">Ações</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-zinc-100">
        <% upload_invites.each do |invite| %>
          <tr>
            <td class="px-4 py-3 font-mono text-xs text-zinc-700"><%= invite.masked_token %></td>
            <td class="px-4 py-3 text-zinc-600"><%= l(invite.created_at, format: :short) %></td>
            <td class="px-4 py-3 text-zinc-600"><%= invite.expires_at ? l(invite.expires_at, format: :short) : "—" %></td>
            <td class="px-4 py-3 text-zinc-600"><%= invite.access_count %></td>
            <td class="px-4 py-3"><%= invite.status_label %></td>
            <td class="px-4 py-3">
              <% if invite.active? %>
                <div class="flex flex-wrap items-center gap-2" data-controller="copy-link">
                  <% url = client_public_upload_url(invite.token) %>
                  <span class="hidden" data-copy-link-target="source"><%= url %></span>
                  <button type="button" class="inline-flex items-center gap-1.5 rounded-md border border-accent/30 bg-accent/5 px-2.5 py-1.5 text-xs font-semibold text-accent shadow-sm transition-colors hover:border-accent/50 hover:bg-accent/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" data-action="copy-link#copy" data-copy-link-target="button">
                    <%= heroicon "clipboard-document", variant: :outline, options: { class: "h-3.5 w-3.5", "aria-hidden": "true" } %>
                    <span data-copy-link-target="label">Copiar link</span>
                  </button>
                  <span class="hidden text-xs font-medium text-emerald-700" data-copy-link-target="feedback" aria-live="polite"></span>
                  <% if !client.archived? && policy(invite.client).show? %>
                    <%= button_to revoke_upload_invite_path(invite),
                          method: :patch,
                          form_class: "inline-flex",
                          class: "inline-flex items-center gap-1.5 rounded-md border border-red-200 bg-red-50 px-2.5 py-1.5 text-xs font-semibold text-red-700 shadow-sm transition-colors hover:border-red-300 hover:bg-red-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600" do %>
                      <%= heroicon "x-mark", variant: :outline, options: { class: "h-3.5 w-3.5", "aria-hidden": "true" } %>
                      Revogar
                    <% end %>
                  <% end %>
                </div>
              <% end %>
            </td>
          </tr>
        <% end %>
        <% if upload_invites.empty? %>
          <tr><td colspan="6" class="px-4 py-8 text-center text-sm text-zinc-500">Nenhum convite para esta competência.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
