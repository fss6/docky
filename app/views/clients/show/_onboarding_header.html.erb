<header class="space-y-4">
  <%= link_to clients_path, class: "inline-flex items-center gap-1 text-sm font-medium text-accent no-underline hover:text-accent-hover" do %>
    <%= heroicon "arrow-left", variant: :outline, options: { class: "h-4 w-4", "aria-hidden": "true" } %>
    Voltar para clientes
  <% end %>

  <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
    <div class="flex flex-wrap items-start gap-4">
      <div class="client-avatar" aria-hidden="true">
        <%= client_initials(client) %>
      </div>
      <div>
        <div class="flex flex-wrap items-center gap-2">
          <h1 class="text-2xl font-semibold tracking-tight text-zinc-900 sm:text-3xl"><%= client.name %></h1>
          <span class="<%= client_onboarding_badge_classes(stale: client_onboarding_stale?(client)) %>">Em onboarding</span>
        </div>
        <p class="mt-1 text-sm text-zinc-500">
          <% if client.tax_id.present? %>CNPJ <%= client.tax_id %><% end %>
          <% if client.email.present? %> · <%= client.email %><% end %>
        </p>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <button type="button" class="app-btn-secondary inline-flex items-center gap-2" data-action="click->share-link-modal#open">
        <%= heroicon "link", variant: :outline, options: { class: "h-4 w-4", "aria-hidden": "true" } %>
        Link de onboarding
      </button>
      <details class="relative">
        <summary class="app-btn-primary inline-flex cursor-pointer list-none items-center gap-2 [&::-webkit-details-marker]:hidden">
          <%= heroicon "cog-6-tooth", variant: :outline, options: { class: "h-4 w-4", "aria-hidden": "true" } %>
          Configurar
        </summary>
        <div class="absolute right-0 z-20 mt-2 w-56 rounded-lg border border-zinc-200 bg-white py-1 shadow-lg">
          <%= link_to "Editar itens do onboarding", client_onboarding_checklist_items_path(client), class: "block px-4 py-2 text-sm text-zinc-700 no-underline hover:bg-zinc-50" %>
          <%= link_to "Dados do cliente", edit_client_path(client), class: "block px-4 py-2 text-sm text-zinc-700 no-underline hover:bg-zinc-50" %>
          <% if policy(Setting).show? %>
            <%= link_to "Mensagens de onboarding", settings_path(anchor: "onboarding-share"), class: "block px-4 py-2 text-sm text-zinc-700 no-underline hover:bg-zinc-50" %>
          <% end %>
          <%= button_to "Remover cliente", client, method: :delete, form: { data: { turbo_confirm: "Excluir este cliente?" } }, class: "block w-full px-4 py-2 text-left text-sm text-red-700 hover:bg-red-50 border-0 bg-transparent" %>
        </div>
      </details>
    </div>
  </div>

  <% if progress.present? %>
    <div class="client-onboarding-card p-5">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-violet-700">Onboarding em andamento</p>
          <p class="mt-1 text-lg font-semibold text-zinc-900">
            <%= progress.received_count %> de <%= progress.total_count %> documentos recebidos
          </p>
        </div>
        <div class="text-right">
          <p class="text-xs font-semibold uppercase tracking-wide text-violet-700">Iniciado</p>
          <p class="mt-1 text-sm font-medium text-zinc-800">há <%= progress.days_since_start %> <%= progress.days_since_start == 1 ? "dia" : "dias" %></p>
        </div>
      </div>

      <div class="mt-4 rounded-full bg-white p-1">
        <div class="client-onboarding-progress-track overflow-hidden">
          <div class="client-onboarding-progress-bar" style="width: <%= progress.percent %>%"></div>
        </div>
      </div>

      <% if progress.pending_names.any? %>
        <p class="mt-3 text-sm text-zinc-700">
          <span class="font-medium">Pendências:</span>
          <%= progress.pending_names.join(", ") %>
        </p>
      <% end %>
    </div>
  <% end %>
</header>
