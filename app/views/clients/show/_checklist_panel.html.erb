<div>
  <h2 class="text-base font-semibold text-zinc-900">Pendências do mês</h2>
  <p class="mt-1 text-sm text-zinc-600"><%= summary[:progress_label] %> · <%= client_period_label(period) %></p>
</div>

<% if checklist_items.empty? %>
  <div class="mt-6 rounded-lg border border-dashed border-zinc-300 bg-zinc-50/80 px-4 py-8 text-center sm:px-6">
    <p class="text-sm font-medium text-zinc-900">Nenhuma pendência configurada para <%= client_period_label(period) %></p>
    <% if template_items_count.positive? %>
      <p class="mt-2 text-sm text-zinc-600">Use os itens padrão do cliente para começar este mês.</p>
      <div class="mt-5 flex justify-center">
        <%= button_to "Montar checklist deste mês",
              sync_to_month_client_checklist_items_path(client, period: period_param),
              method: :post,
              class: "app-btn-primary",
              form: { data: { turbo_stream: true, turbo_frame: "_top" } } %>
      </div>
    <% else %>
      <p class="mt-2 text-sm text-zinc-600">Cadastre os itens padrão do cliente antes de montar o checklist do mês.</p>
      <div class="mt-5">
        <%= link_to "Cadastrar itens padrão",
              client_checklist_items_path(client, period: period_param),
              class: "app-btn-primary no-underline" %>
      </div>
    <% end %>
  </div>
<% else %>
  <ul class="mt-6 divide-y divide-zinc-100">
    <% checklist_items.each do |item| %>
      <%= render "clients/show/checklist_item_row", client: client, item: item, period_param: period_param %>
    <% end %>
  </ul>
<% end %>
