<% period_param = local_assigns.fetch(:period_param) { Date.current.strftime("%Y-%m") } %>
<% folder = local_assigns.fetch(:folder) { Folder.new } %>

<div id="client_new_folder_modal">
  <dialog data-app-form-modal-target="dialog"
          data-action="click->app-form-modal#backdropClick"
          class="z-[200] m-0 w-[min(100%,32rem)] max-w-lg border-0 bg-transparent p-0 shadow-none outline-none [&:not([open])]:hidden [&::backdrop]:bg-black/50"
          style="position: fixed; left: 50%; top: 50%; transform: translate(-50%, -50%);"
          aria-labelledby="new-folder-modal-title">
    <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-xl">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 id="new-folder-modal-title" class="text-xl font-semibold text-zinc-900">Nova pasta</h2>
          <p class="mt-1 text-sm text-zinc-500"><%= client.name %> · arquivo permanente do cliente</p>
        </div>
        <button type="button" class="app-btn-secondary px-2 py-1 text-xs" data-action="click->app-form-modal#close">Fechar</button>
      </div>

      <%= form_with model: [client, folder],
            url: client_folders_path(client, period: period_param),
            data: { turbo_stream: true, action: "turbo:submit-end->app-form-modal#closeOnSuccess" },
            class: "mt-5 space-y-4" do |form| %>
        <%= render "shared/record_errors_toast", record: folder %>

        <div>
          <%= form.label :name, "Nome", class: "app-label" %>
          <%= form.text_field :name,
                class: "app-input",
                autocomplete: "off",
                placeholder: "Ex.: Financeiro 2026",
                required: true %>
        </div>

        <div class="flex justify-end gap-2 border-t border-zinc-100 pt-4">
          <button type="button" class="app-btn-secondary" data-action="click->app-form-modal#close">Cancelar</button>
          <%= form.submit "Criar pasta", class: "app-btn-primary cursor-pointer border-0" %>
        </div>
      <% end %>
    </div>
  </dialog>
</div>
