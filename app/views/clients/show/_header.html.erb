<header class="space-y-4">
  <% back_path = client.archived? ? clients_path(visibility: "archived") : clients_path %>
  <%= link_to back_path, class: "inline-flex items-center gap-1 text-sm font-medium text-accent no-underline hover:text-accent-hover" do %>
    <%= heroicon "arrow-left", variant: :outline, options: { class: "h-4 w-4", "aria-hidden": "true" } %>
    <%= client.archived? ? t("clients.archived.back_to_active") : "Voltar para clientes" %>
  <% end %>

  <% if client.archived? %>
    <%= render "clients/show/archived_banner", client: client %>
  <% end %>

  <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
    <div class="flex gap-4">
      <div class="client-avatar" aria-hidden="true">
        <%= client_initials(client) %>
      </div>
      <div>
        <h1 class="text-2xl font-semibold tracking-tight text-zinc-900 sm:text-3xl"><%= client.name %></h1>
        <p class="mt-1 text-sm text-zinc-500">
          <% if client.tax_id.present? %>CNPJ <%= client.tax_id %><% end %>
          <% if client.email.present? %> · <%= client.email %><% end %>
        </p>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <% if !client.archived? && local_assigns.fetch(:period_open, period_record.present?) %>
        <button type="button" class="app-btn-secondary inline-flex items-center gap-2" data-action="click->share-link-modal#open">
          <%= heroicon "link", variant: :outline, options: { class: "h-4 w-4", "aria-hidden": "true" } %>
          Gerar link de upload
        </button>
      <% end %>
      <%= render "clients/show/configure_menu", client: client, variant: :active, period_param: period_param %>
    </div>
  </div>

  <%= render "clients/show/period_navigator",
        client: client,
        period: period,
        period_param: period_param,
        period_record: local_assigns[:period_record],
        active_tab: active_tab %>

  <%= render "clients/show/summary_band", summary: summary %>
</header>
