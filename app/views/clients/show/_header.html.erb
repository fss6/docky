<header class="space-y-4">
  <%= link_to clients_path, class: "inline-flex items-center gap-1 text-sm font-medium text-accent no-underline hover:text-accent-hover" do %>
    <%= heroicon "arrow-left", variant: :outline, options: { class: "h-4 w-4", "aria-hidden": "true" } %>
    Voltar para clientes
  <% end %>

  <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
    <div class="flex gap-4">
      <div class="client-avatar" aria-hidden="true">
        <%= client_initials(client) %>
      </div>
      <div>
        <h1 class="text-2xl font-semibold tracking-tight text-zinc-900 sm:text-3xl"><%= client.name %></h1>
        <p class="mt-1 text-sm text-zinc-500">
          <% if client.tax_id.present? %>CNPJ <%= client.tax_id %><% end %>
          <% if client.email.present? %> · <%= client.email %><% end %>
        </p>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <button type="button" class="app-btn-secondary inline-flex items-center gap-2" data-action="click->share-link-modal#open">
        <%= heroicon "link", variant: :outline, options: { class: "h-4 w-4", "aria-hidden": "true" } %>
        Gerar link de upload
      </button>
      <details class="relative">
        <summary class="app-btn-primary inline-flex cursor-pointer list-none items-center gap-2 [&::-webkit-details-marker]:hidden">
          <%= heroicon "cog-6-tooth", variant: :outline, options: { class: "h-4 w-4", "aria-hidden": "true" } %>
          Configurar
        </summary>
        <div class="absolute right-0 z-20 mt-2 w-56 rounded-lg border border-zinc-200 bg-white py-1 shadow-lg">
          <%= link_to "Itens padrão do cliente", client_checklist_items_path(client, period: period_param), class: "block px-4 py-2 text-sm text-zinc-700 no-underline hover:bg-zinc-50" %>
          <% if client.active? %>
            <%= button_to "Iniciar onboarding", client_onboarding_start_path(client), method: :post, params: { onboarding_kind: "new_client" }, form: { data: { turbo_confirm: "Iniciar onboarding para este cliente?" } }, class: "block w-full px-4 py-2 text-left text-sm text-zinc-700 hover:bg-zinc-50 border-0 bg-transparent" %>
            <%= button_to "Reabrir onboarding", client_onboarding_reopen_path(client), method: :post, form: { data: { turbo_confirm: "Reabrir onboarding? O cliente voltará ao estado de configuração." } }, class: "block w-full px-4 py-2 text-left text-sm text-zinc-700 hover:bg-zinc-50 border-0 bg-transparent" %>
          <% end %>
          <%= link_to "Dados do cliente", edit_client_path(client), class: "block px-4 py-2 text-sm text-zinc-700 no-underline hover:bg-zinc-50" %>
          <% if policy(Setting).show? %>
            <%= link_to "Mensagens de compartilhamento", settings_path(anchor: "upload-share"), class: "block px-4 py-2 text-sm text-zinc-700 no-underline hover:bg-zinc-50" %>
          <% end %>
          <%= button_to "Remover cliente", client, method: :delete, form: { data: { turbo_confirm: "Excluir este cliente?" } }, class: "block w-full px-4 py-2 text-left text-sm text-red-700 hover:bg-red-50 border-0 bg-transparent" %>
        </div>
      </details>
    </div>
  </div>

  <%= render "clients/show/period_navigator",
        client: client,
        period: period,
        period_param: period_param,
        period_record: local_assigns[:period_record],
        active_tab: active_tab %>

  <%= render "clients/show/summary_band", summary: summary %>
</header>
