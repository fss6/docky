<%= turbo_frame_tag "client_pastas_frame" do %>
  <% if folders.any? %>
    <nav class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-3 xl:grid-cols-4" aria-label="Pastas do cliente">
      <% folders.each do |folder| %>
        <% documents_count = folder.try(:documents_count).to_i %>
        <%= link_to client_folder_path(client, folder, period: period_param),
              class: "group flex flex-col items-center justify-center rounded-xl border border-zinc-200 bg-white px-3 py-5 text-center no-underline shadow-sm transition-colors hover:border-zinc-300 hover:bg-zinc-50",
              data: { turbo_frame: "folder_drawer" } do %>
          <%= heroicon "folder", variant: :solid, options: { class: "h-12 w-12 text-amber-400", "aria-hidden": "true" } %>
          <span class="mt-3 line-clamp-2 text-sm font-medium leading-tight text-zinc-900"><%= folder.name %></span>
          <span class="mt-1 text-xs text-zinc-500"><%= documents_count %> <%= documents_count == 1 ? "arquivo" : "arquivos" %></span>
        <% end %>
      <% end %>
      <% unless client.archived? %>
        <button type="button"
                class="flex flex-col items-center justify-center rounded-xl border border-dashed border-zinc-300 bg-zinc-50/50 px-3 py-5 text-center transition-colors hover:border-zinc-400 hover:bg-zinc-50"
                data-action="click->app-form-modal#open">
          <%= heroicon "plus", variant: :outline, options: { class: "h-10 w-10 text-zinc-400", "aria-hidden": "true" } %>
          <span class="mt-2 text-sm font-medium text-zinc-600">Nova pasta</span>
        </button>
      <% end %>
    </nav>
  <% else %>
    <div class="mt-6 rounded-xl border border-dashed border-zinc-200 bg-zinc-50/50 px-6 py-12 text-center">
      <p class="text-sm font-medium text-zinc-900">Nenhuma pasta cadastrada</p>
      <p class="mt-1 text-sm text-zinc-500">Crie pastas para organizar documentos permanentes deste cliente.</p>
      <% unless client.archived? %>
        <button type="button" class="app-btn-primary mt-4 inline-flex" data-action="click->app-form-modal#open">Nova pasta</button>
      <% end %>
    </div>
  <% end %>
<% end %>
