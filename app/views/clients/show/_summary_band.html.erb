<div id="client_executive_summary" class="client-summary-band grid gap-4 p-4 sm:grid-cols-2 sm:p-5 lg:grid-cols-4 lg:gap-0 lg:divide-x lg:divide-zinc-200/80">
  <div class="lg:pr-5">
    <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Status do mês</p>
    <p class="mt-2">
      <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold <%= summary_status_badge_classes(summary[:status_badge][:tone]) %>">
        <span class="h-1.5 w-1.5 rounded-full bg-current opacity-70" aria-hidden="true"></span>
        <%= summary[:status_badge][:label] %>
      </span>
    </p>
  </div>
  <div class="lg:px-5">
    <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Progresso</p>
    <p class="mt-2 text-sm font-medium text-zinc-900"><%= summary[:progress_label] %></p>
  </div>
  <div class="lg:px-5">
    <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Prazo</p>
    <p class="mt-2 text-sm font-medium text-zinc-900"><%= summary[:deadline][:label] %></p>
  </div>
  <div class="lg:pl-5">
    <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Último envio</p>
    <p class="mt-2 text-sm font-medium text-zinc-900"><%= summary[:last_upload_label] %></p>
  </div>
</div>
