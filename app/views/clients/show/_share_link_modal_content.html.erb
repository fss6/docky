<%# locals: (client:, invite:, period_param:) %>
<% url = client_public_upload_url(invite.token) %>
<div id="share_link_modal_content"
     class="mt-5 space-y-5"
     data-share-link-modal-target="content"
     data-controller="copy-link upload-invite-email"
     data-upload-invite-email-send-url-value="<%= send_email_client_upload_invite_path(client, invite) %>">
  <div>
    <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Link de upload</p>
    <div class="mt-2 flex overflow-hidden rounded-lg border border-zinc-200 bg-zinc-50">
      <div class="min-w-0 flex-1 px-3 py-2.5 text-sm text-zinc-800 break-all" data-copy-link-target="source"><%= url %></div>
      <button type="button"
              class="inline-flex shrink-0 items-center gap-1.5 border-l border-zinc-200 bg-client-accent px-3 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-client-accent-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-client-accent"
              data-action="copy-link#copy"
              data-copy-link-target="button">
        <%= heroicon "clipboard-document", variant: :outline, options: { class: "h-4 w-4", "aria-hidden": "true" } %>
        <span data-copy-link-target="label">Copiar</span>
      </button>
    </div>
  </div>

  <div>
    <div class="flex flex-wrap items-center justify-between gap-2">
      <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Compartilhar diretamente</p>
      <% if policy(Setting).show? %>
        <%= link_to "Personalizar mensagens",
              settings_path(anchor: "upload-share"),
              class: "text-xs font-medium text-accent no-underline hover:text-accent-hover" %>
      <% end %>
    </div>
    <div class="mt-2 grid grid-cols-2 gap-3">
      <%= link_to upload_invite_whatsapp_url(client, url, period_param: period_param),
            target: "_blank",
            rel: "noopener noreferrer",
            class: "flex flex-col items-center gap-2 rounded-lg border border-zinc-200 bg-white px-4 py-4 text-sm font-medium text-zinc-700 no-underline transition-colors hover:border-zinc-300 hover:bg-zinc-50" do %>
        <%= heroicon "chat-bubble-left-right", variant: :outline, options: { class: "h-6 w-6 text-[#25D366]", "aria-hidden": "true" } %>
        WhatsApp
      <% end %>
      <% if client.email.blank? %>
        <div class="flex flex-col items-center gap-2 rounded-lg border border-zinc-200 bg-zinc-50 px-4 py-4 text-sm font-medium text-zinc-400"
             title="Cadastre o e-mail do cliente">
          <%= heroicon "envelope", variant: :outline, options: { class: "h-6 w-6 text-zinc-300", "aria-hidden": "true" } %>
          E-mail
          <span class="text-center text-xs font-normal text-zinc-500">Cadastre o e-mail do cliente</span>
        </div>
      <% else %>
        <button type="button"
                class="flex flex-col items-center gap-2 rounded-lg border border-zinc-200 bg-white px-4 py-4 text-sm font-medium text-zinc-700 transition-colors hover:border-zinc-300 hover:bg-zinc-50 disabled:cursor-not-allowed disabled:opacity-60"
                data-action="upload-invite-email#send"
                data-upload-invite-email-target="button">
          <%= heroicon "envelope", variant: :outline, options: { class: "h-6 w-6 text-[#EA4335]", "aria-hidden": "true" } %>
          <span data-upload-invite-email-target="label">Enviar e-mail</span>
        </button>
      <% end %>
    </div>
  </div>

  <div class="flex gap-3 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3">
    <%= heroicon "exclamation-triangle", variant: :outline, options: { class: "h-5 w-5 shrink-0 text-amber-600", "aria-hidden": "true" } %>
    <p class="text-sm text-amber-900">
      Este link só funciona para esta empresa. Pode ser usado várias vezes até expirar. Você pode revogá-lo a qualquer momento.
    </p>
  </div>
</div>
