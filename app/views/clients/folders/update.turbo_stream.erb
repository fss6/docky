<% if @folder.errors.any? %>
  <%= turbo_stream.replace "folder_edit_modal" do %>
    <%= render "clients/folders/edit_folder_modal",
          client: @client,
          folder: @folder,
          period_param: @period_param %>
  <% end %>
<% else %>
  <%= render "clients/turbo_streams/refresh_pastas_frame",
        client: @client,
        folders: @folders,
        period_param: @period_param %>

  <%= turbo_stream.replace "folder_show_header" do %>
    <%= render "clients/folders/show_header",
          client: @client,
          folder: @folder,
          documents: @documents,
          period_param: @period_param,
          drawer: true %>
  <% end %>

  <%= turbo_stream.replace "folder_edit_modal" do %>
    <%= render "clients/folders/edit_folder_modal",
          client: @client,
          folder: @folder,
          period_param: @period_param %>
  <% end %>
<% end %>

<%= turbo_stream.update "flash_messages" do %>
  <%= render "shared/flash" %>
<% end %>
