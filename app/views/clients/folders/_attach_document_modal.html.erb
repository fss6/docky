<% period_param = local_assigns.fetch(:period_param) { Date.current.strftime("%Y-%m") } %>

<div id="folder_attach_document_modal">
  <dialog data-app-form-modal-target="dialog"
          data-modal-key="attach"
          data-action="click->app-form-modal#backdropClick"
          class="z-[200] m-0 w-[min(100%,32rem)] max-w-lg border-0 bg-transparent p-0 shadow-none outline-none [&:not([open])]:hidden [&::backdrop]:bg-black/50"
          style="position: fixed; left: 50%; top: 50%; transform: translate(-50%, -50%);"
          aria-labelledby="attach-document-modal-title">
    <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-xl">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 id="attach-document-modal-title" class="text-xl font-semibold text-zinc-900"><%= t("folders.attach_document") %></h2>
          <p class="mt-1 text-sm text-zinc-500"><%= folder.name %> · <%= client.name %></p>
        </div>
        <button type="button" class="app-btn-secondary px-2 py-1 text-xs" data-action="click->app-form-modal#close">Fechar</button>
      </div>

      <%= form_with url: client_folder_documents_path(client, folder, period: period_param),
            method: :post,
            html: { multipart: true },
            data: { turbo_stream: true, action: "turbo:submit-end->app-form-modal#closeOnSuccess" },
            class: "mt-5 space-y-4" do %>
        <div>
          <%= label_tag "folder_document_file", "Arquivo", class: "app-label" %>
          <%= file_field_tag "document[file]",
                id: "folder_document_file",
                required: true,
                accept: Documents::AllowedUpload.accept_attribute,
                class: "block w-full rounded-md border border-zinc-200 bg-white px-3 py-2 text-sm text-zinc-700 shadow-sm file:mr-3 file:rounded-md file:border-0 file:bg-zinc-100 file:px-3 file:py-1.5 file:text-sm file:font-medium file:text-zinc-700 hover:file:bg-zinc-200" %>
        </div>

        <div class="flex justify-end gap-2 border-t border-zinc-100 pt-4">
          <button type="button" class="app-btn-secondary" data-action="click->app-form-modal#close">Cancelar</button>
          <%= submit_tag "Enviar arquivo", class: "app-btn-primary cursor-pointer border-0" %>
        </div>
      <% end %>
    </div>
  </dialog>
</div>
