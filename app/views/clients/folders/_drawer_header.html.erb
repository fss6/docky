<% period_param = local_assigns.fetch(:period_param) { Date.current.strftime("%Y-%m") } %>
<% documents_count = documents.size %>
<% drawer_close_path = drawer_empty_client_folders_path(client, period: period_param) %>

<header id="folder_show_header" class="shrink-0 border-b border-zinc-200 bg-white px-4 py-3">
  <div class="flex items-center justify-between gap-2">
    <%= link_to drawer_close_path,
          class: "inline-flex min-w-0 items-center gap-1 rounded-md py-1 pr-2 text-sm font-medium text-zinc-600 no-underline hover:bg-zinc-100 hover:text-zinc-900",
          data: { turbo_frame: "folder_drawer" } do %>
      <%= heroicon "chevron-left", variant: :outline, options: { class: "h-4 w-4 shrink-0", "aria-hidden": "true" } %>
      <span>Pastas</span>
    <% end %>
    <div class="flex shrink-0 items-center gap-0.5">
      <% unless client.archived? %>
        <details class="relative" data-controller="document-link-menu" data-action="toggle->document-link-menu#closeOthers click@window->document-link-menu#closeOnOutside">
          <summary class="inline-flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-md text-zinc-500 hover:bg-zinc-100 [&::-webkit-details-marker]:hidden"
                   title="<%= t("folders.drawer.more_actions") %>"
                   aria-label="<%= t("folders.drawer.more_actions") %>">
            <%= heroicon "ellipsis-horizontal", variant: :outline, options: { class: "h-5 w-5", "aria-hidden": "true" } %>
          </summary>
          <div class="absolute right-0 z-30 mt-1 w-52 rounded-lg border border-zinc-200 bg-white py-1 shadow-lg">
            <button type="button"
                    class="flex w-full items-center gap-2 px-3 py-2 text-left text-sm text-zinc-700 hover:bg-zinc-50 border-0 bg-transparent"
                    data-action="click->app-form-modal#open document-link-menu#close"
                    data-app-form-modal-dialog-param="edit">
              <%= heroicon "pencil-square", variant: :outline, options: { class: "h-4 w-4 text-zinc-400", "aria-hidden": "true" } %>
              Editar nome
            </button>
            <% if folder.empty_for_destroy? %>
              <button type="button"
                      class="flex w-full items-center gap-2 px-3 py-2 text-left text-sm text-red-700 hover:bg-red-50 border-0 bg-transparent"
                      data-action="click->app-confirm-modal#open document-link-menu#close"
                      data-app-confirm-modal-url-param="<%= client_folder_path(client, folder, period: period_param) %>"
                      data-app-confirm-modal-item-label-param="<%= folder.name %>"
                      data-app-confirm-modal-heading-param="<%= t("folders.delete_folder_confirm.heading") %>"
                      data-app-confirm-modal-body-prefix-param="<%= t("folders.delete_folder_confirm.body_prefix") %>"
                      data-app-confirm-modal-body-suffix-param="<%= t("folders.delete_folder_confirm.body_suffix") %>"
                      data-app-confirm-modal-confirm-text-param="<%= t("folders.delete_folder_confirm.confirm") %>"
                      data-app-confirm-modal-turbo-stream-param="true">
                <%= heroicon "trash", variant: :outline, options: { class: "h-4 w-4", "aria-hidden": "true" } %>
                Excluir pasta
              </button>
            <% end %>
          </div>
        </details>
      <% end %>
      <%= link_to drawer_close_path,
            class: "inline-flex h-9 w-9 items-center justify-center rounded-md text-zinc-500 no-underline hover:bg-zinc-100 hover:text-zinc-700",
            data: { turbo_frame: "folder_drawer" },
            aria: { label: t("folders.drawer.close") } do %>
        <%= heroicon "x-mark", variant: :outline, options: { class: "h-5 w-5", "aria-hidden": "true" } %>
      <% end %>
    </div>
  </div>

  <h1 id="folder_drawer_title" class="mt-3 truncate text-lg font-semibold tracking-tight text-zinc-900">
    <%= folder.name %>
  </h1>
  <p class="mt-0.5 text-sm text-zinc-500">
    <%= t("folders.documents_count", count: documents_count) %>
  </p>

  <% unless client.archived? %>
    <button type="button"
            class="app-btn-primary mt-3 flex w-full items-center justify-center gap-2"
            data-action="click->app-form-modal#open"
            data-app-form-modal-dialog-param="attach">
      <%= heroicon "arrow-up-tray", variant: :outline, options: { class: "h-4 w-4", "aria-hidden": "true" } %>
      <%= t("folders.attach_document") %>
    </button>
  <% end %>
</header>
