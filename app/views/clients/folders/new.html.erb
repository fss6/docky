<% content_for :title, "Nova pasta · #{@client.name} · Dokivo" %>

<div class="mx-auto max-w-xl space-y-6">
  <header>
    <p class="text-xs font-semibold uppercase tracking-wide text-accent">Pastas</p>
    <h1 class="mt-1 text-2xl font-semibold tracking-tight text-zinc-900 sm:text-3xl">Nova pasta</h1>
    <p class="mt-2 text-sm leading-relaxed text-zinc-600">
      A pasta será vinculada a <strong><%= @client.name %></strong>.
    </p>
  </header>

  <div class="app-card p-6 sm:p-8">
    <%= render "form", client: @client, folder: @folder %>
  </div>

  <p>
    <%= link_to "← Voltar às pastas", client_path(@client, aba: "pastas", period: params[:period].presence || Date.current.strftime("%Y-%m")),
          class: "text-sm font-medium text-zinc-600 no-underline transition-colors hover:text-zinc-900" %>
  </p>
</div>
