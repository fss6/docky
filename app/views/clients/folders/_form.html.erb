<%= form_with(model: [client, folder], class: "space-y-6") do |form| %>
  <%= render "shared/record_errors_toast", record: folder %>

  <div class="space-y-5">
    <div>
      <%= form.label :name, "Nome", class: "app-label" %>
      <%= form.text_field :name, class: "app-input", autocomplete: "off", placeholder: "Nome da pasta" %>
    </div>
  </div>

  <div class="flex flex-col-reverse gap-3 border-t border-zinc-100 pt-6 sm:flex-row sm:justify-end">
    <%= link_to "Cancelar", client_path(client, aba: "pastas", period: params[:period].presence || Date.current.strftime("%Y-%m")),
          class: "app-btn-secondary text-center sm:text-left" %>
    <%= form.submit folder.persisted? ? "Atualizar pasta" : "Criar pasta", class: "app-btn-primary cursor-pointer border-0" %>
  </div>
<% end %>
