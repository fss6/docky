<%# locals: (form:, client:) %>
<div>
  <%= form.label :name, "Nome", class: "app-label" %>
  <%= form.text_field :name,
        class: "app-input #{'border-red-300' if client.errors[:name].any?}",
        autocomplete: "off",
        placeholder: "Razão social ou nome fantasia",
        data: { client_wizard_target: "step1Field" } %>
  <% if client.errors[:name].any? %>
    <p class="mt-1 text-sm text-red-600"><%= client.errors[:name].first %></p>
  <% end %>
</div>
<div class="grid gap-4 sm:grid-cols-2">
  <div data-controller="tax-id-input">
    <%= form.label :tax_id, "CNPJ / CPF", class: "app-label" %>
    <%= text_field_tag nil,
          (client.tax_id.present? ? format_tax_id(client.tax_id) : nil),
          class: "app-input #{'border-red-300' if client.errors[:tax_id].any?}",
          autocomplete: "off",
          placeholder: "00.000.000/0000-00",
          inputmode: "numeric",
          data: {
            tax_id_input_target: "display",
            client_wizard_target: "step1Field",
            action: "input->tax-id-input#onInput blur->tax-id-input#onBlur"
          } %>
    <%= form.hidden_field :tax_id,
          value: client.tax_id,
          data: { tax_id_input_target: "hidden", client_wizard_target: "step1Field" } %>
    <% if client.errors[:tax_id].any? %>
      <p class="mt-1 text-sm text-red-600"><%= client.errors[:tax_id].first %></p>
    <% end %>
  </div>
  <div>
    <%= form.label :email, "E-mail do responsável", class: "app-label" %>
    <%= form.email_field :email,
          class: "app-input #{'border-red-300' if client.errors[:email].any?}",
          autocomplete: "email",
          placeholder: "contato@empresa.com",
          data: { client_wizard_target: "step1Field" } %>
    <% if client.errors[:email].any? %>
      <p class="mt-1 text-sm text-red-600"><%= client.errors[:email].first %></p>
    <% end %>
  </div>
</div>
<div>
  <%= form.label :phone, "Telefone", class: "app-label" %>
  <%= form.text_field :phone, class: "app-input", autocomplete: "tel", placeholder: "Opcional" %>
</div>
<div>
  <%= form.label :notes, "Observações", class: "app-label" %>
  <%= form.text_area :notes, class: "app-input min-h-[5rem]", rows: 3, placeholder: "Opcional" %>
</div>
