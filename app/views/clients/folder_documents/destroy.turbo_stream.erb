<%= render "clients/turbo_streams/refresh_pastas_frame",
      client: @client,
      folders: @folders,
      period_param: @period_param %>

<%= turbo_stream.replace "folder_documents_frame" do %>
  <%= render "clients/folders/documents_list",
        client: @client,
        folder: @folder,
        documents: @documents,
        period_param: @period_param,
        drawer: true %>
<% end %>

<%= turbo_stream.replace "folder_show_header" do %>
  <%= render "clients/folders/show_header",
        client: @client,
        folder: @folder,
        documents: @documents,
        period_param: @period_param,
        drawer: true %>
<% end %>

<%= turbo_stream.update "flash_messages" do %>
  <%= render "shared/flash" %>
<% end %>
