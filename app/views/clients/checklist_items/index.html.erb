<% content_for :title, "Checklist · #{@client.name}" %>
<div class="mx-auto max-w-2xl space-y-6">
  <%= link_to "← Voltar ao cliente", client_path(@client, aba: "checklist", period: @period.strftime("%Y-%m")), class: "text-sm font-medium text-accent no-underline" %>
  <h1 class="text-2xl font-semibold text-zinc-900">Itens padrão do cliente</h1>

  <%= form_with model: [@client, ClientChecklistItem.new], url: client_checklist_items_path(@client), class: "app-card space-y-3 p-4" do |f| %>
    <%= f.label :name, "Novo item", class: "app-label" %>
    <%= f.text_field :name, class: "app-input", required: true %>
    <%= f.submit "Adicionar", class: "app-btn-primary" %>
  <% end %>

  <%= button_to "Montar checklist do mês atual",
        sync_to_month_client_checklist_items_path(@client, period: @period.strftime("%Y-%m")),
        method: :post,
        class: "app-btn-secondary" %>

  <ul class="app-card divide-y divide-zinc-100">
    <% @template_items.each do |item| %>
      <li class="flex items-center justify-between px-4 py-3 text-sm">
        <span><%= item.name %></span>
        <span class="text-xs text-zinc-500"><%= item.active? ? "Ativo" : "Inativo" %></span>
      </li>
    <% end %>
  </ul>
</div>
