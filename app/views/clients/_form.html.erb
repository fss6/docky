<%# locals: (client:, onboarding_template_counts: {}) %>
<%= form_with(model: client, class: "space-y-6", data: { controller: "onboarding-form" }) do |form| %>
  <% if client.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-900 shadow-[var(--shadow-card)]" role="alert">
      <% err_n = client.errors.count %>
      <p class="font-medium"><%= err_n %> <%= err_n == 1 ? "erro impediu" : "erros impediram" %> salvar este cliente:</p>
      <ul class="mt-2 list-inside list-disc space-y-0.5 text-red-800">
        <% client.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-5">
    <div class="app-card p-5 space-y-4">
      <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Dados básicos</p>
      <div>
        <%= form.label :name, "Nome", class: "app-label" %>
        <%= form.text_field :name, class: "app-input", autocomplete: "off", placeholder: "Razão social ou nome fantasia" %>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= form.label :tax_id, "CNPJ / CPF", class: "app-label" %>
          <%= form.text_field :tax_id, class: "app-input", autocomplete: "off", placeholder: "Opcional" %>
        </div>
        <div>
          <%= form.label :email, "E-mail do responsável", class: "app-label" %>
          <%= form.email_field :email, class: "app-input", autocomplete: "email", placeholder: "Opcional" %>
        </div>
      </div>
      <div>
        <%= form.label :phone, "Telefone", class: "app-label" %>
        <%= form.text_field :phone, class: "app-input", autocomplete: "tel", placeholder: "Opcional" %>
      </div>
      <div>
        <%= form.label :notes, "Observações", class: "app-label" %>
        <%= form.text_area :notes, class: "app-input min-h-[5rem]", rows: 3, placeholder: "Opcional" %>
      </div>
    </div>

    <% unless client.persisted? %>
      <% new_count = onboarding_template_counts["new_company"] || 7 %>
      <% migration_count = onboarding_template_counts["migration"] || 12 %>
      <div class="app-card p-5 space-y-3">
        <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Tipo de onboarding</p>

        <label class="flex cursor-pointer items-start gap-3 rounded-lg p-3 onboarding-radio-selected" data-onboarding-form-target="option" data-action="click->onboarding-form#select">
          <input type="radio" name="onboarding_kind" value="new_client" checked class="mt-1 border-zinc-300 text-client-accent focus:ring-client-accent" data-onboarding-form-target="radio">
          <span>
            <span class="block text-sm font-semibold text-zinc-900">Cliente novo (constituição ou existente)</span>
            <span class="mt-0.5 block text-xs text-zinc-500">Aplicará template padrão: <%= new_count %> itens (contrato social, RG sócios, certificado digital, etc.)</span>
          </span>
        </label>

        <label class="flex cursor-pointer items-start gap-3 rounded-lg p-3 onboarding-radio-default" data-onboarding-form-target="option" data-action="click->onboarding-form#select">
          <input type="radio" name="onboarding_kind" value="migration" class="mt-1 border-zinc-300 text-client-accent focus:ring-client-accent" data-onboarding-form-target="radio">
          <span>
            <span class="block text-sm font-semibold text-zinc-900">Migração de outra contabilidade</span>
            <span class="mt-0.5 block text-xs text-zinc-500">Aplicará template estendido: <%= migration_count %> itens (inclui balancete, ECD, IRPJ anterior)</span>
          </span>
        </label>

        <label class="flex cursor-pointer items-start gap-3 rounded-lg p-3 onboarding-radio-default" data-onboarding-form-target="option" data-action="click->onboarding-form#select">
          <input type="radio" name="onboarding_kind" value="skipped" class="mt-1 border-zinc-300 text-client-accent focus:ring-client-accent" data-onboarding-form-target="radio">
          <span>
            <span class="block text-sm font-semibold text-zinc-900">Pular onboarding (cliente já tem tudo)</span>
            <span class="mt-0.5 block text-xs text-zinc-500">Cliente entra direto como ativo. Use se já tiver toda documentação fora do Dokivo.</span>
          </span>
        </label>
      </div>
    <% end %>
  </div>

  <div class="flex flex-col-reverse gap-3 border-t border-zinc-100 pt-6 sm:flex-row sm:justify-end">
    <%= link_to "Cancelar", clients_path, class: "app-btn-secondary text-center sm:text-left" %>
    <% if client.persisted? %>
      <%= form.submit "Atualizar cliente", class: "app-btn-primary cursor-pointer border-0" %>
    <% else %>
      <%= form.submit "Cadastrar e iniciar onboarding →", class: "app-btn-primary cursor-pointer border-0", data: { onboarding_form_target: "submit" } %>
    <% end %>
  </div>
<% end %>
