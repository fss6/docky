<%= form_with(model: client, class: "space-y-6") do |form| %>
  <%= render "shared/record_errors_toast", record: client %>

  <div class="space-y-5">
    <div class="app-card p-5 space-y-4">
      <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Dados básicos</p>
      <%= render "form_fields", form: form, client: client %>
    </div>
  </div>

  <div class="flex flex-col-reverse gap-3 border-t border-zinc-100 pt-6 sm:flex-row sm:justify-end">
    <%= link_to "Cancelar", client.persisted? ? client_path(client) : clients_path, class: "app-btn-secondary text-center sm:text-left" %>
    <%= form.submit client.persisted? ? "Atualizar cliente" : "Cadastrar cliente", class: "app-btn-primary cursor-pointer border-0" %>
  </div>
<% end %>
