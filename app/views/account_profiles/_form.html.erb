<%= form_with model: account, url: account_profile_path, method: :patch, class: "space-y-6", html: { multipart: true } do |form| %>
  <%= render "shared/record_errors_toast", record: account %>

  <div class="grid gap-8 lg:grid-cols-2 lg:items-start lg:gap-10">
    <section class="space-y-5">
      <h2 class="text-sm font-semibold text-zinc-900"><%= t("account_profiles.form.section_account") %></h2>

      <div>
        <%= form.label :logo, t("account_profiles.form.logo"), class: "app-label" %>
        <div class="mt-2 flex items-center gap-4">
          <%= account_logo(account, size: :lg) %>
          <div class="min-w-0 flex-1 space-y-2">
            <%= form.file_field :logo,
                  accept: Accounts::LogoUpload.accept_attribute,
                  class: "block w-full text-sm text-zinc-600 file:mr-3 file:rounded-md file:border-0 file:bg-zinc-100 file:px-3 file:py-2 file:text-sm file:font-medium file:text-zinc-700 hover:file:bg-zinc-200" %>
            <p class="text-sm text-zinc-500"><%= t("account_profiles.form.logo_hint") %></p>
            <% if account.logo.attached? %>
              <div class="flex items-center gap-2">
                <%= form.check_box :remove_logo, class: "h-4 w-4 rounded border-zinc-300 text-accent focus:ring-2 focus:ring-accent/25" %>
                <%= form.label :remove_logo, t("account_profiles.form.remove_logo"), class: "text-sm text-zinc-700" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <div>
        <%= form.label :name, class: "app-label" %>
        <%= form.text_field :name, class: "app-input", autocomplete: "organization" %>
      </div>

      <div>
        <%= form.label :contact_email, t("account_profiles.form.contact_email"), class: "app-label" %>
        <%= form.email_field :contact_email, class: "app-input", autocomplete: "email" %>
      </div>

      <div>
        <%= form.label :description, class: "app-label" %>
        <%= form.text_area :description, rows: 4, class: "app-input min-h-[120px] resize-y" %>
      </div>
    </section>

    <section class="lg:sticky lg:top-20">
      <%= render "subscription_summary", account: account %>
    </section>
  </div>

  <div class="flex flex-col-reverse gap-3 border-t border-zinc-100 pt-6 sm:flex-row sm:justify-end">
    <%= link_to t("account_profiles.form.cancel"), dashboard_path, class: "app-btn-secondary text-center sm:text-left" %>
    <%= form.submit t("account_profiles.form.submit"), class: "app-btn-primary cursor-pointer border-0" %>
  </div>
<% end %>
