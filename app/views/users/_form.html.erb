<%= form_with(model: user, class: "space-y-6") do |form| %>
  <%= render "shared/record_errors_toast", record: user %>

  <div class="space-y-5">
    <div>
      <%= form.label :name, class: "app-label" %>
      <%= form.text_field :name, class: "app-input", autocomplete: "name" %>
    </div>

    <div>
      <%= form.label :email, class: "app-label" %>
      <%= form.email_field :email, class: "app-input", autocomplete: "email" %>
    </div>

    <div>
      <%= form.label :role, class: "app-label" %>
      <% if policy(user).edit_role? %>
        <%= form.select :role,
              User.role_options_for_select(administrator: current_user.role_administrator?),
              { prompt: t("helpers.user.role_prompt") },
              class: "app-input" %>
      <% else %>
        <%= form.hidden_field :role, value: user.role %>
        <p class="mt-1.5 rounded-lg border border-zinc-200 bg-zinc-50/80 px-4 py-3 text-sm font-medium text-zinc-800">
          <%= user.role_label %>
        </p>
        <p class="mt-1.5 text-sm text-zinc-500">
          <% if user == current_user %>
            <%= t("users.form.cannot_change_own_role") %>
          <% elsif user.founding_user? %>
            <%= t("users.form.founding_owner_role_locked") %>
          <% else %>
            <%= t("users.form.last_active_owner_role_locked") %>
          <% end %>
        </p>
      <% end %>
    </div>

    <div class="rounded-lg border border-zinc-200 bg-zinc-50/80 px-4 py-3">
      <% if policy(user).edit_active? %>
        <div class="flex items-center gap-3">
          <%= form.check_box :active, class: "h-4 w-4 rounded border-zinc-300 text-accent focus:ring-2 focus:ring-accent/25" %>
          <%= form.label :active, class: "text-sm font-medium text-zinc-700" %>
        </div>
      <% else %>
        <%= form.hidden_field :active, value: user.active? %>
        <p class="text-sm font-medium text-zinc-700">
          <%= user.active? ? t("users.status.active") : t("users.status.inactive") %>
        </p>
        <p class="mt-1 text-sm text-zinc-500">
          <% if user == current_user %>
            <%= t("users.form.cannot_change_own_active") %>
          <% elsif user.founding_user? %>
            <%= t("users.form.founding_owner_active_locked") %>
          <% else %>
            <%= t("users.form.last_active_owner_active_locked") %>
          <% end %>
        </p>
      <% end %>
    </div>
  </div>

  <div class="flex flex-col-reverse gap-3 border-t border-zinc-100 pt-6 sm:flex-row sm:justify-end">
    <%= link_to t("users.form.cancel"), users_path, class: "app-btn-secondary text-center sm:text-left" %>
    <%= form.submit class: "app-btn-primary cursor-pointer border-0" %>
  </div>
<% end %>
