<% content_for :title, "Conversa · Dokivo" %>

<%= turbo_stream_from "conversation_#{@conversation.id}" %>

<div
  class="chat-module flex min-h-0 flex-1 flex-col overflow-hidden rounded-2xl border border-zinc-100 bg-white shadow-[var(--shadow-float)] lg:flex-row"
  data-controller="app-confirm-modal"
>
  <%= render "conversations/sidebar",
        account: @account,
        conversation: @conversation,
        sidebar_conversations: @sidebar_conversations %>

  <div class="relative flex min-h-0 min-w-0 flex-1 flex-col bg-gradient-to-b from-zinc-50/90 to-white" data-controller="chat">
    <div class="flex min-h-0 flex-1 flex-col px-4 pb-4 pt-3 sm:px-6 lg:px-8 lg:pb-5">
      <div
        id="messages"
        data-chat-target="messages"
        class="mx-auto flex min-h-0 w-full max-w-3xl flex-1 flex-col gap-6 overflow-y-auto overscroll-contain rounded-xl p-4 pb-6 sm:p-5 sm:pb-8 [scrollbar-gutter:stable]"
      >
        <% if @messages.any? %>
          <%= render partial: "messages/message", collection: @messages, as: :message, locals: { account: @account } %>
        <% else %>
          <%= render "messages/empty_state", focus_document: @focus_document %>
        <% end %>
      </div>

      <div id="chat-form" class="mx-auto mt-5 w-full max-w-3xl shrink-0 pt-1 sm:mt-6 pb-[max(0.25rem,env(safe-area-inset-bottom))]">
        <%= render "messages/chat_form",
              account: @account,
              conversation: @conversation,
              focus_document_id: @focus_document_id %>
      </div>
    </div>
  </div>

  <%= render "conversations/delete_modal" %>
</div>
