<%= form_with model: user, url: profile_path, method: :patch, class: "space-y-6", html: { multipart: true } do |form| %>
  <%= render "shared/record_errors_toast", record: user %>

  <div class="space-y-5">
    <div>
      <%= form.label :avatar, t("profiles.form.avatar"), class: "app-label" %>
      <div class="mt-2 flex items-center gap-4">
        <%= user_avatar(user, size: :lg) %>
        <div class="min-w-0 flex-1 space-y-2">
          <%= form.file_field :avatar,
                accept: Users::AvatarUpload.accept_attribute,
                class: "block w-full text-sm text-zinc-600 file:mr-3 file:rounded-md file:border-0 file:bg-zinc-100 file:px-3 file:py-2 file:text-sm file:font-medium file:text-zinc-700 hover:file:bg-zinc-200" %>
          <p class="text-sm text-zinc-500"><%= t("profiles.form.avatar_hint") %></p>
          <% if user.avatar.attached? %>
            <div class="flex items-center gap-2">
              <%= form.check_box :remove_avatar, class: "h-4 w-4 rounded border-zinc-300 text-accent focus:ring-2 focus:ring-accent/25" %>
              <%= form.label :remove_avatar, t("profiles.form.remove_avatar"), class: "text-sm text-zinc-700" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div>
      <%= form.label :name, class: "app-label" %>
      <%= form.text_field :name, class: "app-input", autocomplete: "name" %>
    </div>

    <div>
      <%= form.label :email, class: "app-label" %>
      <%= form.email_field :email, class: "app-input", autocomplete: "email" %>
    </div>
  </div>

  <div class="flex flex-col-reverse gap-3 border-t border-zinc-100 pt-6 sm:flex-row sm:justify-end">
    <%= link_to t("profiles.form.cancel"), dashboard_path, class: "app-btn-secondary text-center sm:text-left" %>
    <%= form.submit t("profiles.form.submit"), class: "app-btn-primary cursor-pointer border-0" %>
  </div>
<% end %>
