<% content_for :title, "Configurações · Dokivo" %>

<div class="space-y-6">
  <header>
    <p class="text-xs font-semibold uppercase tracking-wide text-accent">Sistema</p>
    <h1 class="mt-1 text-2xl font-semibold tracking-tight text-zinc-900 sm:text-3xl">Configurações</h1>
    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-zinc-600">Escolha um módulo para visualizar e editar as configurações da conta.</p>
  </header>

  <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
    <% if policy(:account_permissions).show? %>
      <%= render "settings/hub_card",
            path: settings_permissions_path,
            icon: "shield-check",
            eyebrow: t("settings.permissions.hub.eyebrow"),
            title: t("settings.permissions.hub.title"),
            description: t("settings.permissions.hub.description") %>
    <% end %>

    <% if policy(OnboardingTemplate).index? %>
      <%= render "settings/hub_card",
            path: settings_onboarding_templates_path,
            icon: "clipboard-document-list",
            eyebrow: "Templates",
            title: "Onboarding de clientes",
            description: "Crie templates personalizados ou edite os padrões usados no onboarding dos clientes." %>
    <% end %>

    <% if policy(@setting).update? %>
      <%= render "settings/hub_card",
            path: edit_settings_ai_settings_path,
            icon: "sparkles",
            eyebrow: "Assistente",
            title: "Automações com IA",
            description: "Controle as automações do seu assistente de IA." %>

      <%= render "settings/hub_card",
            path: edit_settings_collection_ladder_path,
            icon: "bell-alert",
            eyebrow: "Pendências",
            title: "Lembretes automáticos",
            description: "Etapas, canais e mensagens para cobrar pendências de documentos." %>

      <%= render "settings/hub_card",
            path: edit_settings_upload_share_path,
            icon: "paper-airplane",
            eyebrow: "Compartilhamento",
            title: "Convite mensal",
            description: "Edite mensagens de WhatsApp e e-mail para coleta mensal." %>

      <%= render "settings/hub_card",
            path: edit_settings_onboarding_share_path,
            icon: "chat-bubble-left-right",
            eyebrow: "Onboarding",
            title: "Mensagens de onboarding",
            description: "Configure textos de WhatsApp e e-mail para convite inicial." %>
    <% end %>
  </section>
</div>
