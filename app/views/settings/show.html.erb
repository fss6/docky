<% content_for :title, "Configurações · Dokivo" %>

<div class="space-y-6">
  <header>
    <p class="text-xs font-semibold uppercase tracking-wide text-accent">Sistema</p>
    <h1 class="mt-1 text-2xl font-semibold tracking-tight text-zinc-900 sm:text-3xl">Configurações</h1>
    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-zinc-600">Escolha um módulo para visualizar e editar as configurações da conta.</p>
  </header>

  <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
    <article class="app-card p-5">
      <div class="flex items-start gap-3">
        <div class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-accent/10 text-accent">
          <%= heroicon "clipboard-document-list", variant: :outline, options: { class: "h-5 w-5", "aria-hidden": "true" } %>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Onboarding</p>
          <h2 class="mt-1 text-lg font-semibold text-zinc-900">Templates de itens</h2>
        </div>
      </div>
      <p class="mt-2 text-sm text-zinc-600">Gerencie templates e itens usados no onboarding dos clientes.</p>
      <p class="mt-3 text-xs text-zinc-500"><%= pluralize(@onboarding_template_count, "template") %> configurado(s)</p>
      <div class="mt-4">
        <%= link_to "Ver templates", settings_onboarding_templates_path, class: "app-btn-primary" %>
      </div>
    </article>

    <article class="app-card p-5">
      <div class="flex items-start gap-3">
        <div class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-accent/10 text-accent">
          <%= heroicon "sparkles", variant: :outline, options: { class: "h-5 w-5", "aria-hidden": "true" } %>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Inteligência</p>
          <h2 class="mt-1 text-lg font-semibold text-zinc-900">Tags automáticas com IA</h2>
        </div>
      </div>
      <p class="mt-2 text-sm text-zinc-600">Controle a geração automática de tags para documentos processados.</p>
      <p class="mt-3 text-xs text-zinc-500">
        Status: <%= @setting.generate_tags_automatically? ? "ativo" : "inativo" %>
      </p>
      <div class="mt-4">
        <%= link_to "Editar IA", edit_settings_ai_settings_path, class: "app-btn-primary" %>
      </div>
    </article>

    <article class="app-card p-5">
      <div class="flex items-start gap-3">
        <div class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-accent/10 text-accent">
          <%= heroicon "paper-airplane", variant: :outline, options: { class: "h-5 w-5", "aria-hidden": "true" } %>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Compartilhamento</p>
          <h2 class="mt-1 text-lg font-semibold text-zinc-900">Convite mensal</h2>
        </div>
      </div>
      <p class="mt-2 text-sm text-zinc-600">Edite mensagens de WhatsApp e e-mail para coleta mensal.</p>
      <p class="mt-3 text-xs text-zinc-500">Placeholders: {{nome_cliente}}, {{competencia}}, {{link}}</p>
      <div class="mt-4">
        <%= link_to "Editar compartilhamento", edit_settings_upload_share_path, class: "app-btn-primary" %>
      </div>
    </article>

    <article class="app-card p-5">
      <div class="flex items-start gap-3">
        <div class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-accent/10 text-accent">
          <%= heroicon "chat-bubble-left-right", variant: :outline, options: { class: "h-5 w-5", "aria-hidden": "true" } %>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Onboarding</p>
          <h2 class="mt-1 text-lg font-semibold text-zinc-900">Mensagens de onboarding</h2>
        </div>
      </div>
      <p class="mt-2 text-sm text-zinc-600">Configure textos de WhatsApp e e-mail para convite inicial.</p>
      <p class="mt-3 text-xs text-zinc-500">Placeholders: {{nome_cliente}}, {{progresso}}, {{link}}</p>
      <div class="mt-4">
        <%= link_to "Editar onboarding", edit_settings_onboarding_share_path, class: "app-btn-primary" %>
      </div>
    </article>
  </section>
</div>
