<% content_for :title, "Mensagens de onboarding · Dokivo" %>
<% onboarding_defaults = Setting.onboarding_share_defaults %>

<div class="space-y-6" data-controller="app-confirm-modal">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-accent">Configurações</p>
      <h1 class="mt-1 text-2xl font-semibold tracking-tight text-zinc-900 sm:text-3xl">Mensagens de onboarding</h1>
      <p class="mt-2 max-w-3xl text-sm leading-relaxed text-zinc-600">Defina as mensagens de convite de onboarding por WhatsApp e e-mail.</p>
    </div>
    <%= link_to "Voltar para o hub", settings_path, class: "app-btn-secondary" %>
  </header>

  <%= render "shared/record_errors_toast", record: @setting %>

  <%= form_with model: @setting, url: settings_onboarding_share_path, method: :patch, class: "space-y-6", data: { controller: "auto-resize-textarea" } do |form| %>
    <section class="app-card p-5"
             data-controller="template-default-restore"
             data-template-default-restore-texts-value="<%= [onboarding_defaults[:whatsapp]].to_json %>"
             data-template-default-restore-confirm-heading-value="<%= t("settings.template_defaults.confirm_whatsapp.heading") %>"
             data-template-default-restore-confirm-body-value="<%= t("settings.template_defaults.confirm_whatsapp.body") %>"
             data-template-default-restore-confirm-text-value="<%= t("settings.template_defaults.confirm_modal.confirm") %>">
      <%= render "settings/template_card_header",
            title: "Mensagem de WhatsApp",
            hint: "Obrigatório conter <code class=\"rounded bg-zinc-100 px-1\">{{link}}</code>.".html_safe %>
      <div class="mt-4">
        <%= form.label :onboarding_share_whatsapp_template, "Mensagem", class: "sr-only" %>
        <%= form.text_area :onboarding_share_whatsapp_template,
              rows: 1,
              class: "w-full resize-none rounded-lg border border-zinc-300 px-3 py-2 text-sm text-zinc-900 shadow-sm focus:border-accent focus:ring-accent",
              data: {
                template_default_restore_target: "field",
                auto_resize_textarea_target: "field",
                action: "input->auto-resize-textarea#resize"
              } %>
      </div>
    </section>

    <section class="app-card p-5"
             data-controller="template-default-restore"
             data-template-default-restore-texts-value="<%= [onboarding_defaults[:email_subject], onboarding_defaults[:email_body]].to_json %>"
             data-template-default-restore-confirm-heading-value="<%= t("settings.template_defaults.confirm_email.heading") %>"
             data-template-default-restore-confirm-body-value="<%= t("settings.template_defaults.confirm_email.body") %>"
             data-template-default-restore-confirm-text-value="<%= t("settings.template_defaults.confirm_modal.confirm") %>">
      <%= render "settings/template_card_header",
            title: "E-mail de onboarding",
            hint: "Placeholders disponíveis: {{nome_cliente}}, {{progresso}}, {{link}}. #{t("settings.template_defaults.email_layout_note")}" %>
      <div class="mt-4 space-y-4">
        <div>
          <%= form.label :onboarding_share_email_subject_template, "Assunto", class: "app-label" %>
          <%= form.text_field :onboarding_share_email_subject_template,
                class: "app-input mt-1.5",
                data: { template_default_restore_target: "field" } %>
        </div>
        <div>
          <%= form.label :onboarding_share_email_body_template, "Corpo da mensagem", class: "app-label" %>
          <%= form.text_area :onboarding_share_email_body_template,
                rows: 1,
                class: "app-input mt-1.5 resize-none",
                data: {
                  template_default_restore_target: "field",
                  auto_resize_textarea_target: "field",
                  action: "input->auto-resize-textarea#resize"
                } %>
        </div>
      </div>
    </section>

    <div class="flex justify-end gap-2">
      <%= link_to "Cancelar", settings_path, class: "app-btn-secondary" %>
      <%= form.submit "Salvar onboarding", class: "app-btn-primary cursor-pointer border-0" %>
    </div>
  <% end %>

  <%= render "settings/template_restore_confirm_modal" %>
</div>
