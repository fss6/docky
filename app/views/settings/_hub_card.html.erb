<%# locals: path:, icon:, eyebrow:, title:, description:, aria_label: nil %>
<%= link_to path,
      class: "app-card app-card-hover group block p-5 no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent",
      aria: { label: local_assigns.fetch(:aria_label, title) } do %>
  <div class="flex items-start justify-between gap-3">
    <div class="flex min-w-0 items-start gap-3">
      <div class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-accent/10 text-accent">
        <%= heroicon icon, variant: :outline, options: { class: "h-5 w-5", "aria-hidden": "true" } %>
      </div>
      <div class="min-w-0">
        <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500"><%= eyebrow %></p>
        <h2 class="mt-1 text-lg font-semibold text-zinc-900 transition-colors group-hover:text-accent"><%= title %></h2>
      </div>
    </div>
    <%= heroicon "chevron-right", variant: :outline, options: {
      class: "mt-1 inline-block h-4 w-4 shrink-0 text-zinc-400 transition-colors group-hover:text-accent",
      "aria-hidden": "true"
    } %>
  </div>
  <p class="mt-2 text-sm text-zinc-600"><%= description %></p>
<% end %>
