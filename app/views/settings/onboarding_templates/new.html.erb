<% content_for :title, "Novo template · Dokivo" %>

<div class="mx-auto max-w-xl space-y-6">
  <header>
    <p class="text-xs font-semibold uppercase tracking-wide text-accent">Templates de onboarding</p>
    <h1 class="mt-1 text-2xl font-semibold tracking-tight text-zinc-900 sm:text-3xl"><%= t("settings.onboarding_templates.new.title") %></h1>
    <p class="mt-2 text-sm leading-relaxed text-zinc-600"><%= t("settings.onboarding_templates.new.description") %></p>
  </header>

  <%= render "shared/record_errors_toast", record: @template %>

  <div class="app-card p-6 sm:p-8">
    <%= form_with model: @template,
          url: settings_onboarding_templates_path,
          class: "space-y-5" do |form| %>
      <div>
        <%= form.label :name, t("settings.onboarding_templates.new.name_label"), class: "app-label" %>
        <%= form.text_field :name,
              class: "app-input mt-1.5",
              autocomplete: "off",
              placeholder: t("settings.onboarding_templates.new.name_placeholder") %>
      </div>

      <div class="flex flex-col-reverse gap-3 border-t border-zinc-100 pt-5 sm:flex-row sm:justify-end">
        <%= link_to t("settings.onboarding_templates.new.cancel"),
              settings_onboarding_templates_path,
              class: "app-btn-secondary text-center" %>
        <%= form.submit t("settings.onboarding_templates.new.submit"), class: "app-btn-primary cursor-pointer border-0" %>
      </div>
    <% end %>
  </div>

  <p>
    <%= link_to t("settings.onboarding_templates.new.back"),
          settings_onboarding_templates_path,
          class: "text-sm font-medium text-zinc-600 no-underline transition-colors hover:text-zinc-900" %>
  </p>
</div>
