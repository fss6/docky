<% content_for :title, "#{@template.name} · Templates de onboarding · Dokivo" %>

<div class="space-y-6">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-accent">Templates de onboarding</p>
      <h1 class="mt-1 text-2xl font-semibold tracking-tight text-zinc-900 sm:text-3xl"><%= @template.name %></h1>
      <p class="mt-2 max-w-3xl text-sm leading-relaxed text-zinc-600">
        Itens que serão copiados para novos checklists criados com este template.
      </p>
    </div>
    <div class="flex flex-wrap gap-2">
      <% if policy(@template).edit? %>
        <%= link_to "Editar", edit_settings_onboarding_template_path(@template), class: "app-btn-primary" %>
      <% end %>
      <%= link_to "Voltar", settings_onboarding_templates_path, class: "app-btn-secondary" %>
    </div>
  </header>

  <section class="app-card p-5 sm:p-6">
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Tipo</p>
        <p class="mt-1 text-sm font-medium text-zinc-900"><%= @template.kind.humanize %></p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Itens</p>
        <p class="mt-1 text-sm font-medium text-zinc-900"><%= "#{@items.size} #{@items.size == 1 ? "item" : "itens"}" %></p>
      </div>
    </div>
  </section>

  <section class="app-card overflow-hidden">
    <div class="border-b border-zinc-100 bg-zinc-50/80 px-5 py-4 sm:px-6">
      <h2 class="text-sm font-semibold text-zinc-900">Itens do template</h2>
      <p class="mt-1 text-sm text-zinc-600">Ordem e instruções visíveis para o cliente no onboarding.</p>
    </div>

    <div class="divide-y divide-zinc-100">
      <% @items.each do |item| %>
        <div class="px-5 py-4 sm:px-6">
          <div class="flex gap-4">
            <span class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-zinc-100 text-xs font-semibold text-zinc-600">
              <%= item.position + 1 %>
            </span>
            <div class="min-w-0">
              <p class="text-sm font-medium text-zinc-900"><%= item.name %></p>
              <% if item.help_text.present? %>
                <p class="mt-1 text-sm text-zinc-500"><%= item.help_text %></p>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </section>
</div>
