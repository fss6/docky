<% content_for :title, "Lembretes automáticos · Dokivo" %>
<% client_reminder_steps = @steps.reject(&:kind_internal_alert?) %>

<div class="space-y-6">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-accent">Pendências</p>
      <h1 class="mt-1 text-2xl font-semibold tracking-tight text-zinc-900 sm:text-3xl">Lembretes automáticos</h1>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-zinc-600">Defina as etapas, canais e mensagens. O sistema cobra pendências de checklist conforme o prazo de cada cliente.</p>
    </div>
    <%= link_to "Voltar para o hub", settings_path, class: "app-btn-secondary" %>
  </header>

  <%= render "shared/record_errors_toast", record: @collection_setting %>

  <%= form_with model: @collection_setting, url: settings_collection_ladder_path, method: :patch do |form| %>
    <%= hidden_field_tag :section, "behavior" %>
    <section class="app-card space-y-5 p-5 sm:p-6">
      <h2 class="text-lg font-semibold text-zinc-900">Comportamento</h2>

      <div class="grid gap-3 sm:grid-cols-2">
        <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-zinc-200 bg-white px-4 py-3">
          <%= form.check_box :enabled, class: "mt-0.5 h-4 w-4 shrink-0 rounded border-zinc-300 text-accent focus:ring-accent" %>
          <span class="min-w-0">
            <span class="block text-sm font-medium text-zinc-800">Lembretes ativos</span>
            <span class="mt-0.5 block text-xs leading-relaxed text-zinc-500">Dispara e-mail e WhatsApp nas etapas configuradas, conforme o prazo de cada cliente. Desligado, nenhuma mensagem automática é enviada.</span>
          </span>
        </label>
        <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-zinc-200 bg-white px-4 py-3">
          <%= form.check_box :auto_confirm_receipt, class: "mt-0.5 h-4 w-4 shrink-0 rounded border-zinc-300 text-accent focus:ring-accent" %>
          <span class="min-w-0">
            <span class="block text-sm font-medium text-zinc-800">Confirmar recebimento automático</span>
            <span class="mt-0.5 block text-xs leading-relaxed text-zinc-500">Quando o cliente envia pelo link público, os itens do checklist da competência passam a recebido sem ação manual da equipe.</span>
          </span>
        </label>
      </div>

      <div class="grid gap-4 lg:grid-cols-3 lg:items-stretch">
        <div class="rounded-lg border border-zinc-200 bg-zinc-50/60 p-4 lg:col-span-2">
          <p class="text-sm font-medium text-zinc-800">Horário de silêncio</p>
          <p class="mt-0.5 text-xs text-zinc-500">Nenhuma mensagem é enviada neste intervalo.</p>
          <div class="mt-3 grid grid-cols-2 gap-3">
            <div>
              <%= form.label :quiet_hours_start, "Desde", class: "app-label" %>
              <%= form.time_field :quiet_hours_start, class: "app-input mt-1 w-full" %>
            </div>
            <div>
              <%= form.label :quiet_hours_end, "Até", class: "app-label" %>
              <%= form.time_field :quiet_hours_end, class: "app-input mt-1 w-full" %>
            </div>
          </div>
        </div>
        <div class="flex flex-col rounded-lg border border-zinc-200 bg-zinc-50/60 p-4">
          <p class="text-sm font-medium text-zinc-800">Limite por cliente/dia</p>
          <p class="mt-0.5 text-xs text-zinc-500">Máximo de mensagens automáticas no mesmo dia.</p>
          <%= form.select :max_messages_per_client_per_day,
                (1..3).map { |n| [n, n] },
                {},
                class: "app-input mt-3 w-full" %>
        </div>
      </div>

      <div class="flex justify-end border-t border-zinc-100 pt-4">
        <%= form.submit "Salvar comportamento", class: "app-btn-primary" %>
      </div>
    </section>
  <% end %>

  <div class="space-y-3">
    <div>
      <h2 class="text-lg font-semibold text-zinc-900">Etapas dos lembretes</h2>
      <p class="mt-1 text-xs text-zinc-500">Disparados automaticamente conforme o prazo do checklist.</p>
      <p class="mt-2 text-xs text-zinc-500">Cada etapa dispara em relação ao prazo mensal do cliente (dia definido no cadastro do cliente).</p>
      <%= render "step_timing_timeline", steps: @steps %>
      <p class="mt-3 text-xs text-zinc-500">Variáveis nos templates: {cliente}, {documentos_faltantes}, {prazo}, {link_upload}, {escritorio}</p>
    </div>

    <div class="grid gap-6 lg:grid-cols-2">
      <div class="space-y-3">
        <h3 class="flex items-center gap-2 text-sm font-semibold text-zinc-900">
          <%= heroicon "envelope", variant: :outline, options: { class: "h-5 w-5 shrink-0 text-blue-600", "aria-hidden": "true" } %>
          E-mail
        </h3>
        <% @steps.each do |step| %>
          <%= render "step_email_accordion", step: step %>
        <% end %>
      </div>

      <div class="space-y-3">
        <h3 class="flex items-center gap-2 text-sm font-semibold text-zinc-900">
          <%= heroicon "chat-bubble-left-right", variant: :outline, options: { class: "h-5 w-5 shrink-0 text-[#25D366]", "aria-hidden": "true" } %>
          WhatsApp
        </h3>
        <% client_reminder_steps.each do |step| %>
          <%= render "step_whatsapp_accordion", step: step %>
        <% end %>
      </div>
    </div>
  </div>
</div>
