<div class="rounded-lg border border-zinc-200 bg-zinc-50/60 p-3 sm:p-4">
  <p class="text-sm font-medium text-zinc-800">Linha do tempo</p>
  <p class="mt-0.5 text-xs text-zinc-500">Momento do envio em relação ao prazo mensal do cliente.</p>

  <div class="mt-3 flex flex-wrap items-center gap-2 sm:gap-1">
    <% steps.each_with_index do |step, index| %>
      <% if index.positive? %>
        <span class="hidden shrink-0 px-0.5 text-xs font-medium text-zinc-400 sm:inline" aria-hidden="true">→</span>
      <% end %>
      <% timeline_styles = collection_step_timing_styles(step, variant: :timeline) %>
      <div class="flex min-w-[9.5rem] max-w-full flex-1 items-center gap-2 rounded-lg border px-2.5 py-2 sm:min-w-0 sm:flex-initial <%= timeline_styles %>">
        <%= heroicon collection_step_timing_icon(step),
              variant: :outline,
              options: { class: "h-4 w-4 shrink-0", "aria-hidden": "true" } %>
        <div class="min-w-0">
          <span class="text-xs font-bold tabular-nums"><%= collection_step_offset_code(step) %></span>
          <span class="mt-0.5 block truncate text-[11px] leading-tight opacity-90"><%= collection_step_timing_phrase(step) %></span>
        </div>
      </div>
    <% end %>
  </div>
</div>
