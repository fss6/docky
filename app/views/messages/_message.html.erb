<%# locals: message, account: nil %>
<% if message.user? %>
  <div id="<%= dom_id(message) %>" class="flex w-full flex-col items-end gap-1">
    <div
      class="max-w-[85%] rounded-2xl rounded-br-md bg-accent px-4 py-2.5 text-sm leading-relaxed text-white shadow-sm"
    >
      <%= simple_format message.content, {}, class: "mb-0 whitespace-pre-wrap [&_p]:mb-0" %>
    </div>
    <time class="pr-1 text-[11px] tabular-nums text-zinc-400" datetime="<%= message.created_at.iso8601 %>">
      <%= message.created_at.strftime("%H:%M") %>
    </time>
  </div>
<% else %>
  <div id="<%= dom_id(message) %>" class="flex w-full flex-col items-start gap-1.5">
    <div class="flex items-center gap-2 px-1">
      <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-teal-50 text-accent ring-1 ring-teal-100">
        <%= heroicon "sparkles", variant: :outline, options: { class: "h-4 w-4", "aria-hidden": "true" } %>
      </span>
      <span class="text-xs font-medium text-zinc-500"><%= t("messages.chat.assistant_name") %></span>
    </div>
    <div class="min-w-0 w-full max-w-[85%]">
      <%= render "messages/content", message: message %>
      <% if message.sources.present? && !message.streaming %>
        <div class="mt-2.5 flex flex-wrap gap-2">
          <% message.sources.each do |src| %>
            <% wiki_slug = src["wiki_slug"] %>
            <% doc_id = src["document_id"] %>
            <% chip_label =
                 if wiki_slug.present?
                   src["wiki_title"].presence || wiki_slug
                 else
                   "#{src["file"]} · p. #{src["page"].presence || "?"}"
                 end %>
            <% chip_class = "inline-flex max-w-full items-center gap-1 rounded-md border border-zinc-200/90 bg-white px-2 py-1 text-xs text-zinc-700 shadow-sm transition-colors hover:border-teal-300/80 hover:bg-teal-50/90" %>
            <% if wiki_slug.present? %>
              <%= link_to wiki_page_path(slug: wiki_slug),
                    class: chip_class,
                    data: { turbo_frame: "_top" },
                    title: chip_label do %>
                <%= heroicon "book-open", variant: :outline, options: { class: "h-3.5 w-3.5 shrink-0 text-zinc-500", "aria-hidden": "true" } %>
                <span class="min-w-0 truncate"><%= chip_label %></span>
              <% end %>
            <% elsif local_assigns[:account] && doc_id.present? %>
              <%= link_to document_path(doc_id),
                    class: chip_class,
                    data: { turbo_frame: "_top" },
                    title: "Abrir documento" do %>
                <%= heroicon "document-text", variant: :outline, options: { class: "h-3.5 w-3.5 shrink-0 text-zinc-500", "aria-hidden": "true" } %>
                <span class="min-w-0 truncate"><%= chip_label %></span>
              <% end %>
            <% else %>
              <span class="<%= chip_class %> cursor-default">
                <%= heroicon "document-text", variant: :outline, options: { class: "h-3.5 w-3.5 shrink-0 text-zinc-500", "aria-hidden": "true" } %>
                <span class="min-w-0 truncate"><%= chip_label %></span>
              </span>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
    <time class="pl-1 text-[11px] tabular-nums text-zinc-400" datetime="<%= message.created_at.iso8601 %>">
      <%= message.created_at.strftime("%H:%M") %>
    </time>
  </div>
<% end %>
