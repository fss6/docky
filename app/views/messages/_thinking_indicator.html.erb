<%# locals: (primary_label:, secondary_label: nil, show_brand: false) %>
<div class="flex min-h-[3rem] flex-col justify-center gap-2" aria-busy="true">
  <% if show_brand %>
    <p class="text-xs font-medium text-zinc-400"><%= t("messages.chat.thinking_status.brand") %></p>
  <% end %>
  <div class="flex items-center gap-1.5">
    <span class="thinking-dot inline-block h-2 w-2 rounded-full bg-zinc-400"></span>
    <span class="thinking-dot animation-delay-200 inline-block h-2 w-2 rounded-full bg-zinc-400"></span>
    <span class="thinking-dot animation-delay-400 inline-block h-2 w-2 rounded-full bg-zinc-400"></span>
  </div>
  <% if primary_label.present? %>
    <p class="text-sm text-zinc-500"><%= primary_label %></p>
  <% end %>
  <% if secondary_label.present? %>
    <p class="text-xs text-zinc-400"><%= secondary_label %></p>
  <% end %>
</div>
