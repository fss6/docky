<%# locals: (account:, conversation:, focus_document_id: nil) %>
<%= form_with url: account_conversation_messages_path(account, conversation),
              data: { chat_target: "form" },
              class: "flex min-w-0 flex-col gap-2" do |f| %>
  <% if focus_document_id.present? %>
    <%= hidden_field_tag "message[focus_document_id]", focus_document_id %>
  <% end %>
  <% if focus_document_id.present? %>
    <div class="inline-flex max-w-full items-center gap-2 self-start rounded-lg border border-teal-100/60 bg-teal-50/80 px-2.5 py-1 text-xs text-teal-800">
      <%= heroicon "funnel", variant: :outline, options: { class: "h-3.5 w-3.5 shrink-0", "aria-hidden": "true" } %>
      <span class="font-medium text-teal-700">Documento em foco</span>
      <span class="text-teal-800/90">— priorizado nesta conversa</span>
    </div>
  <% end %>
  <div class="flex items-end gap-2 rounded-2xl border border-zinc-100 bg-white p-1.5 shadow-sm transition-[border-color,box-shadow] focus-within:border-teal-200 focus-within:ring-2 focus-within:ring-accent/15">
    <label class="sr-only" for="chat-input">Mensagem</label>
    <textarea
      id="chat-input"
      name="message[content]"
      rows="1"
      data-chat-target="input"
      data-action="keydown->chat#keydown input->chat#resize"
      placeholder="<%= focus_document_id.present? ? "Digite sua pergunta sobre este documento…" : "Digite sua mensagem aqui…" %>"
      class="max-h-24 min-w-0 flex-1 resize-none self-start border-0 bg-transparent px-2 py-1.5 text-sm leading-5 text-zinc-900 outline-none placeholder:text-zinc-400 focus:ring-0"
    ></textarea>
    <button
      type="button"
      data-action="chat#submit"
      class="mb-0.5 inline-flex h-9 w-9 shrink-0 items-center justify-center self-end rounded-xl bg-accent text-white shadow-sm transition-colors hover:bg-teal-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      aria-label="Enviar mensagem"
    >
      <%= heroicon "paper-airplane", variant: :mini, options: { class: "h-4 w-4 shrink-0 text-white", "aria-hidden": "true" } %>
    </button>
  </div>
<% end %>
