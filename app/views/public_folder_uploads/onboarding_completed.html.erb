<% content_for :title, t("public_folder_uploads.onboarding_completed.title", client: @client.name) %>

<div class="mx-auto w-full max-w-xl space-y-6">
  <div class="rounded-xl border border-zinc-200 bg-white px-5 py-4 shadow-[var(--shadow-card)] sm:px-6">
    <%= render "public_folder_uploads/portal_header", account: @account %>
  </div>

  <header class="space-y-2 text-center">
    <p class="text-sm text-zinc-600"><%= @client.name %></p>
  </header>

  <div class="portal-onboarding-completed-hero">
    <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-white/20 text-lg" aria-hidden="true">✓</span>
    <h1 class="mt-3 text-lg font-semibold"><%= t("public_folder_uploads.onboarding_completed.heading") %></h1>
    <p class="mt-2 text-sm text-white/90">
      <%= t("public_folder_uploads.onboarding_completed.body") %>
    </p>
  </div>

  <% if @progress.present? %>
    <div class="rounded-xl border border-emerald-200 bg-white p-4 shadow-[var(--shadow-card)]">
      <div class="flex items-center justify-between text-sm">
        <span class="font-medium text-zinc-900"><%= t("public_folder_uploads.onboarding_completed.progress_label") %></span>
        <span class="font-semibold text-emerald-700"><%= @progress.received_count %> de <%= @progress.total_count %></span>
      </div>
      <div class="client-onboarding-progress-track mt-3 overflow-hidden">
        <div class="client-onboarding-progress-bar" style="width: 100%"></div>
      </div>
    </div>
  <% end %>

  <div class="space-y-2">
    <% @onboarding_items.each do |item| %>
      <div class="rounded-xl border border-emerald-200 bg-emerald-50/50 px-4 py-3 opacity-90">
        <div class="flex items-center gap-3">
          <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-xs text-white">
            ✓
          </span>
          <p class="min-w-0 flex-1 text-sm text-zinc-600 line-through"><%= item.name %></p>
        </div>
      </div>
    <% end %>
  </div>

  <% if @client.email.present? %>
    <p class="text-center text-sm text-zinc-600">
      <%= t("public_folder_uploads.onboarding_completed.email_notice", email: @client.email) %>
    </p>
  <% end %>

  <p class="text-center text-xs text-zinc-500">
    <%= t("public_folder_uploads.onboarding_completed.close_hint") %>
  </p>
  <%= render "public_folder_uploads/secure_footer" %>
</div>
