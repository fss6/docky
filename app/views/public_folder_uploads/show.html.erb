<% content_for :title, "Envie seus documentos · #{@period_label}" %>

<section class="app-card mx-auto w-full max-w-3xl overflow-hidden">
  <div class="border-b border-zinc-100 px-5 py-4 sm:px-6">
    <%= render "public_folder_uploads/portal_header", account: @portal_account %>
  </div>

  <div class="space-y-5 px-5 py-6 sm:px-8 sm:py-7">
    <div class="text-center">
      <%= render "public_folder_uploads/period_chip", period_label: @period_label %>
    </div>

    <header class="space-y-2 text-center">
      <h1 class="text-2xl font-semibold tracking-tight text-zinc-900 sm:text-3xl">Envie seus documentos</h1>
      <p class="text-sm text-zinc-600">
        NF-e, extratos, comprovantes ou contratos.<br>
        Aceitamos <%= Documents::AllowedUpload.client_facing_label %>
      </p>
    </header>

    <%= render "public_folder_uploads/upload_dropzone", upload_token: @upload_token %>

    <%= render "public_folder_uploads/pending_documents",
          period_label: @period_label,
          pending_checklist_items: @pending_checklist_items %>

    <%= render "public_folder_uploads/recent_uploads", recent_public_documents: @recent_public_documents %>
  </div>
</section>

<%= render "public_folder_uploads/secure_footer" %>
