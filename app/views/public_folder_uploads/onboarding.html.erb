<% content_for :title, "Onboarding · #{@client.name}" %>

<div class="mx-auto w-full max-w-xl space-y-6">
  <header class="space-y-2 text-center">
    <p class="text-lg font-semibold text-violet-800"><%= @account_name %></p>
    <p class="text-sm text-zinc-600">Bem-vindo · <strong class="text-zinc-900"><%= @client.name %></strong></p>
  </header>

  <div class="portal-onboarding-hero">
    <h1 class="text-lg font-semibold">Vamos configurar sua conta?</h1>
    <p class="mt-2 text-sm text-white/90">
      Precisamos de alguns documentos para configurar tudo direitinho.<br>
      São poucos itens — depois disso, é só usar.
    </p>
  </div>

  <% if @progress.present? %>
    <div class="rounded-xl border border-zinc-200 bg-white p-4 shadow-[var(--shadow-card)]">
      <div class="flex items-center justify-between text-sm">
        <span class="font-medium text-zinc-900">Seu progresso</span>
        <span class="font-semibold text-violet-700"><%= @progress.received_count %> de <%= @progress.total_count %></span>
      </div>
      <div class="client-onboarding-progress-track mt-3 overflow-hidden">
        <div class="client-onboarding-progress-bar" style="width: <%= @progress.percent %>%"></div>
      </div>
    </div>
  <% end %>

  <div class="space-y-2">
    <% @onboarding_items.each do |item| %>
      <% complete = item.complete? %>
      <% selected = @selected_item&.id == item.id %>
      <div class="rounded-xl border px-4 py-3 <%= complete ? "border-emerald-200 bg-emerald-50/50 opacity-75" : selected ? "border-violet-400 bg-violet-50/40" : "border-zinc-200 bg-white" %>">
        <div class="flex items-center gap-3">
          <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-xs <%= complete ? "bg-emerald-600 text-white" : "border-2 border-zinc-300 bg-white text-transparent" %>">
            <%= "✓" if complete %>
          </span>
          <div class="min-w-0 flex-1">
            <p class="text-sm <%= complete ? "text-zinc-500 line-through" : "font-medium text-zinc-900" %>"><%= item.name %></p>
            <% if item.help_text.present? && !complete %>
              <p class="mt-0.5 text-xs text-zinc-500"><%= item.help_text %></p>
            <% end %>
          </div>
          <% unless complete %>
            <%= link_to "Enviar →",
                  public_onboarding_upload_path(token: @upload_token, item_id: item.id),
                  class: "shrink-0 text-sm font-medium text-violet-700 no-underline hover:text-violet-900" %>
          <% end %>
        </div>

        <% if selected && !complete %>
          <%= form_with url: public_onboarding_upload_path(token: @upload_token),
                method: :post,
                html: { multipart: true, class: "mt-4 space-y-3 border-t border-violet-100 pt-4" } do %>
            <%= hidden_field_tag :onboarding_checklist_item_id, item.id %>
            <%= file_field_tag "document[file]",
                  required: true,
                  class: "block w-full rounded-md border border-zinc-300 bg-white px-3 py-2 text-sm file:mr-3 file:rounded-md file:border-0 file:bg-violet-50 file:px-3 file:py-2 file:text-sm file:font-medium file:text-violet-800" %>
            <%= submit_tag "Enviar documento", class: "app-btn-primary w-full sm:w-auto" %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <details class="rounded-xl border border-zinc-200 bg-white p-4 text-sm text-zinc-600">
    <summary class="cursor-pointer font-medium text-zinc-800">Enviar outro documento (fora da lista)</summary>
    <%= form_with url: public_onboarding_extra_upload_path(token: @upload_token),
          method: :post,
          html: { multipart: true, class: "mt-3 space-y-3" } do %>
      <%= file_field_tag "document[file]", required: true, class: "block w-full text-sm" %>
      <%= submit_tag "Enviar documento extra", class: "app-btn-secondary w-full sm:w-auto" %>
    <% end %>
  </details>

  <p class="text-center text-xs text-zinc-500">
    Dúvida sobre algum documento? Entre em contato com sua contabilidade.
  </p>
  <p class="text-center text-[10px] uppercase tracking-wide text-zinc-400">Conexão segura</p>
</div>
