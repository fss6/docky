<%= form_with url: public_folder_upload_path(token: upload_token),
      method: :post,
      html: {
        multipart: true,
        class: "space-y-4",
        data: {
          controller: "file-drop",
          file_drop_extensions_value: Documents::AllowedUpload::EXTENSIONS.to_json,
          file_drop_extensions_label_value: Documents::AllowedUpload.client_facing_label
        }
      } do %>
  <div class="portal-upload-dropzone rounded-xl border-2 border-dashed border-client-accent bg-client-accent-muted/30 px-5 py-10 text-center sm:px-8"
       data-file-drop-target="zone"
       data-action="click->file-drop#zoneClick dragenter->file-drop#dragEnter dragleave->file-drop#dragLeave dragover->file-drop#dragOver drop->file-drop#drop">
    <p class="text-3xl" aria-hidden="true">📤</p>
    <p class="mt-3 text-sm font-medium text-zinc-900" data-file-drop-target="hint">Arraste arquivos aqui</p>
    <p class="mt-1 hidden text-sm font-medium text-zinc-700" data-file-drop-target="fileName"></p>
    <p class="mt-2 hidden text-sm text-red-600" data-file-drop-target="error" role="alert"></p>
    <p class="mt-2 text-xs text-zinc-500">ou</p>
    <%= file_field_tag "document[file]",
          id: :public_document_file,
          required: true,
          accept: Documents::AllowedUpload.accept_attribute,
          class: "sr-only",
          data: {
            file_drop_target: "input",
            action: "change->file-drop#changed"
          } %>
    <label for="public_document_file"
           class="mt-3 inline-flex cursor-pointer items-center justify-center rounded-md bg-client-accent px-4 py-2 text-sm font-medium text-white shadow-sm transition-colors hover:bg-client-accent-hover focus-within:outline focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-client-accent">
      Selecionar do computador
    </label>
  </div>
<% end %>
